---
import '~/assets/styles/tailwind.css';

import {I18N} from '~/utils/config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Uncomment line below to activate View Transitions
import {ClientRouter} from 'astro:transitions';

import type {MetaData as MetaDataType} from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const {metadata = {}} = Astro.props;
const {language, textDirection} = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
<head>
  <CommonMeta/>
  <Favicons/>
  <CustomStyles/>
  <ApplyColorMode/>
  <Metadata {...metadata}/>
  <SiteVerification/>
  <Analytics/>
  <ClientRouter fallback="swap"/>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jeremiah Chienda",
    "image": "https://pub-a0f6f56fff3c42b9bb30bd2143c99754.r2.dev/2026.jpg",
    "jobTitle": "AI Engineer",
    "description": "AI Engineer specializing in production agent systems, RAG pipelines, and LLM-powered applications for govtech and fintech.",
    "url": "https://chienda.com",
    "knowsAbout": [
      "AI Agent Architecture",
      "Retrieval Augmented Generation",
      "Large Language Models",
      "Model Context Protocol",
      "Agent-to-Agent Protocol",
      "Generative UI",
      "AI Safety",
      "Token Economics",
      "Tool Calling",
      "Human-in-the-Loop Systems",
      "LangGraph",
      "Azure AI Foundry",
      "Microsoft Fabric"
    ],
    "worksFor": {
      "@type": "Organization",
      "name": "Irembo"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Doshisha University"
    },
    "sameAs": [
      "https://linkedin.com/in/jchienda",
      "https://github.com/liwoo",
      "https://twitter.com/liwucodes"
    ]
  })} />
</head>

<body class="text-default bg-page tracking-normal font-mono">
<slot/>

<!-- Dev Mode build-status badge (shown only when html.dev-mode is set) -->
<div class="dmj-sidebar" aria-hidden="true">
  <div>build_ver: 2.0.26</div>
  <div>render_engine: editorial_json</div>
  <div>status: dev_mode</div>
</div>

<!-- Global subtle scanline overlay -->
<div class="fixed inset-0 pointer-events-none z-[9999]" aria-hidden="true" style="background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.03) 3px, rgba(0,0,0,0.03) 4px); mix-blend-mode: multiply;"></div>

<BasicScripts/>
<style is:global>
  img {
    content-visibility: auto;
  }

  /* Dev Mode: swap index listings for an editorial JSON document */
  [data-dev-json] {
    display: none;
  }
  html.dev-mode [data-dev-normal] {
    display: none;
  }
  html.dev-mode [data-dev-json] {
    display: block;
  }

  .dmj-doc {
    --dmj-bg: #0a0a0c;
    --dmj-ink: #d1d1d1;
    --dmj-cyan: #06b6d4;
    --dmj-cyan-lt: #22d3ee;
    --dmj-amber: #f59e0b;
    --dmj-amber-lt: #fcd34d;
    --dmj-ghost: #1a1a1e;
    position: relative;
    overflow: hidden;
    margin: 1.5rem 0;
    padding: 2.5rem 1.5rem;
    background: var(--dmj-bg);
    color: var(--dmj-ink);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Space Mono', monospace;
  }
  @media (min-width: 768px) {
    .dmj-doc {
      padding: 3.5rem 3rem;
    }
  }
  .dmj-doc ::selection {
    background: rgba(6, 182, 212, 0.3);
  }

  .dmj-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.2;
    background-image: radial-gradient(#2a2a2a 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .dmj-watermark {
    position: absolute;
    top: 0.5rem;
    right: 1.25rem;
    pointer-events: none;
    z-index: 1;
    font-size: clamp(2.5rem, 9vw, 5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--dmj-ghost);
    transition: color 0.3s ease;
  }
  .dmj-doc:hover .dmj-watermark {
    color: rgba(6, 182, 212, 0.06);
  }
  .dmj-shell {
    position: relative;
    z-index: 10;
    max-width: 64rem;
    margin: 0 auto;
  }

  .dmj-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: dmjRise 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .dmj-front.dmj-reveal {
    animation-delay: 0.05s;
  }
  .dmj-code.dmj-reveal {
    animation-delay: 0.18s;
  }
  @keyframes dmjRise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dmj-reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .dmj-front {
    position: relative;
    margin-bottom: 2.5rem;
    padding-left: 1rem;
  }
  .dmj-front-rule {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    opacity: 0.5;
    background: linear-gradient(to bottom, var(--dmj-amber), transparent);
  }
  .dmj-dashes {
    color: rgba(245, 158, 11, 0.8);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }
  .dmj-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 2rem;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0.6rem 0;
  }
  @media (min-width: 768px) {
    .dmj-meta {
      grid-template-columns: 180px 1fr;
    }
  }
  .dmj-key {
    color: #6b7280;
    font-style: italic;
  }
  .dmj-val {
    color: #fff;
    word-break: break-word;
  }

  .dmj-code {
    position: relative;
    z-index: 10;
    margin: 0;
    overflow-x: auto;
    color: var(--dmj-ink);
    font-size: 0.82rem;
    line-height: 1.7;
    white-space: pre;
    tab-size: 2;
    font-family: inherit;
  }
  .dmj-code .devj-key {
    color: var(--dmj-amber-lt);
  }
  .dmj-code .devj-str {
    color: #e5e7eb;
  }
  .dmj-code .devj-num {
    color: var(--dmj-cyan-lt);
  }
  .dmj-code .devj-bool {
    color: var(--dmj-amber);
  }
  .dmj-code .devj-null {
    color: #f87171;
  }
  .dmj-code .devj-punc {
    color: var(--dmj-cyan);
  }

  /* Fixed build-status badge — only while Dev Mode is active */
  .dmj-sidebar {
    display: none;
  }
  html.dev-mode .dmj-sidebar {
    display: block;
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 9998;
    pointer-events: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: #4b5563;
  }
</style>
</body>
</html>
