---
import '~/assets/styles/tailwind.css';

import {I18N} from '~/utils/config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Uncomment line below to activate View Transitions
import {ClientRouter} from 'astro:transitions';

import type {MetaData as MetaDataType} from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const {metadata = {}} = Astro.props;
const {language, textDirection} = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
<head>
  <CommonMeta/>
  <Favicons/>
  <CustomStyles/>
  <ApplyColorMode/>
  <Metadata {...metadata}/>
  <SiteVerification/>
  <Analytics/>
  <ClientRouter fallback="swap"/>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jeremiah Chienda",
    "image": "https://pub-a0f6f56fff3c42b9bb30bd2143c99754.r2.dev/2026.jpg",
    "jobTitle": "AI Engineer",
    "description": "AI Engineer specializing in production agent systems, RAG pipelines, and LLM-powered applications for govtech and fintech.",
    "url": "https://chienda.com",
    "knowsAbout": [
      "AI Agent Architecture",
      "Retrieval Augmented Generation",
      "Large Language Models",
      "Model Context Protocol",
      "Agent-to-Agent Protocol",
      "Generative UI",
      "AI Safety",
      "Token Economics",
      "Tool Calling",
      "Human-in-the-Loop Systems",
      "LangGraph",
      "Azure AI Foundry",
      "Microsoft Fabric"
    ],
    "worksFor": {
      "@type": "Organization",
      "name": "Irembo"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Doshisha University"
    },
    "sameAs": [
      "https://linkedin.com/in/jchienda",
      "https://github.com/liwoo",
      "https://twitter.com/liwucodes"
    ]
  })} />
</head>

<body class="text-default bg-page tracking-normal font-mono">
<slot/>

<!-- Global subtle scanline overlay -->
<div class="fixed inset-0 pointer-events-none z-[9999]" aria-hidden="true" style="background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.03) 3px, rgba(0,0,0,0.03) 4px); mix-blend-mode: multiply;"></div>

<BasicScripts/>
<style is:global>
  img {
    content-visibility: auto;
  }

  /* Dev Mode: swap index listings for a JSON editor panel */
  [data-dev-json] {
    display: none;
  }
  html.dev-mode [data-dev-normal] {
    display: none;
  }
  html.dev-mode [data-dev-json] {
    display: block;
  }

  .dev-json-editor {
    margin: 1.5rem 0;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 0.6rem;
    overflow: hidden;
    background: #0d1117;
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.6);
  }
  .dev-json-titlebar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    background: #161b22;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }
  .dev-json-dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 9999px;
    display: inline-block;
  }
  .dev-json-dot--red {
    background: #ff5f56;
  }
  .dev-json-dot--yellow {
    background: #ffbd2e;
  }
  .dev-json-dot--green {
    background: #27c93f;
  }
  .dev-json-filename {
    margin-left: 0.6rem;
    color: #8b949e;
    font-size: 0.72rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    letter-spacing: 0.03em;
  }
  .dev-json-code {
    margin: 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    color: #c9d1d9;
    font-size: 0.8rem;
    line-height: 1.65;
    font-family: 'Space Mono', ui-monospace, monospace;
    white-space: pre;
    tab-size: 2;
  }
  .dev-json-code .devj-key {
    color: #7ee787;
  }
  .dev-json-code .devj-str {
    color: #a5d6ff;
  }
  .dev-json-code .devj-num {
    color: #79c0ff;
  }
  .dev-json-code .devj-bool {
    color: #ffab70;
  }
  .dev-json-code .devj-null {
    color: #ff7b72;
  }
</style>
</body>
</html>
