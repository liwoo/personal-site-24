---
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    /** Optional eyebrow; defaults to `legal` (privacy, terms). */
    label?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <PageHeader label={frontmatter?.label ?? 'legal'} width="container-article">
    <Fragment slot="title">{frontmatter?.title}</Fragment>
  </PageHeader>
  <div
    class="markdown-content container-article pb-16 lg:pb-24 prose max-w-3xl dark:prose-invert prose-headings:text-default prose-headings:font-heading prose-headings:tracking-tight prose-headings:font-bold prose-a:text-primary dark:prose-a:text-primary prose-a:underline-offset-4 prose-img:border prose-img:border-gray-500/30"
  >
    <slot />
  </div>
</Layout>
