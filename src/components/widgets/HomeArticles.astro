---
import { APP_BLOG } from '~/utils/config';
import { findPostsByCategory } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

type Props = {
  count?: number;
};

const { count = 5 } = Astro.props;
const posts = APP_BLOG.isEnabled ? (await findPostsByCategory('tech')).slice(0, count) : [];
---

<section id="blog-section" class="container-lg py-16 lg:py-20">
  <div class="flex items-end justify-between gap-4 mb-6">
    <div>
      <p class="terminal-label">writing</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">AI agent engineering, in practice</h2>
    </div>
    <a href="/blog" class="btn-link text-xs hidden sm:inline-flex shrink-0">All articles</a>
  </div>

  <details class="see-more mb-6">
    <summary><span class="see-more-label">See</span></summary>
    <p class="mt-3 text-sm text-muted max-w-2xl">
      Agent architectures, memory, tool calling, RAG, MCP and generative UI, plus the trade-offs that only show up in
      production: token economics, evals and safety.
    </p>
  </details>

  <ul class="glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
    {
      posts.map((post) => (
        <li>
          <a
            href={getPermalink(post.permalink, 'post')}
            class="post-row group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-4 sm:px-6 py-4 transition-colors"
            data-astro-prefetch
          >
            <time datetime={String(post.publishDate)} class="text-xs text-muted shrink-0 sm:w-32 tabular-nums">
              {getFormattedDate(post.publishDate)}
            </time>
            <span class="flex-1 font-semibold text-default group-hover:text-primary transition-colors leading-snug">
              {post.title}
            </span>
            {post.readingTime && <span class="hidden sm:inline text-xs text-muted shrink-0">{post.readingTime} min</span>}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 sm:hidden">
    <a href="/blog" class="btn-link text-xs">All articles</a>
  </div>
</section>

<style>
  .post-row:hover {
    background: rgb(216 145 33 / 0.06);
  }
</style>
