---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { quickCall } from '~/data/booking';
import type { Link } from '~/types';

const image = 'https://pub-a0f6f56fff3c42b9bb30bd2143c99754.r2.dev/2026.jpg';

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  cryptoLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative container sm:px-6 dark:text-slate-300">
    <div
      class="glass glass-sheen rounded-2xl grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12 p-6 lg:p-12"
    >
      <div class="col-span-12 lg:col-span-3">
        <Image
          class="bg-gray-500 rounded-lg grayscale hover:grayscale-0 transition hidden sm:block"
          width={120}
          height={120}
          widths={[400, 768]}
          layout="fixed"
          src={image}
          alt="Jeremiah Chienda — AI Engineer"
        />
      </div>
      {
        links.map(({ links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-4">
                    <a
                      class="text-muted hover:text-default hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      <div class="col-span-12 md:col-span-3 lg:col-span-3 flex flex-col gap-3 md:items-end md:text-right">
        <p class="terminal-label">work_with_me</p>
        <a href={quickCall.href} class="btn-primary rounded-md w-full md:w-auto" data-open-book-me aria-haspopup="dialog">
          Book_me
        </a>
        {
          socialLinks?.length ? (
            <ul class="flex -ml-2.5 md:ml-0 md:-mr-2.5">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="text-muted hover:text-primary focus:outline-none text-sm p-2.5 inline-flex items-center transition-colors"
                    aria-label={ariaLabel}
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {icon && <Icon name={icon} class="w-5 h-5" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          ) : null
        }
      </div>
    </div>
    <div class="text-center my-6 text-xs text-muted">
      <Fragment set:html={footNote} />
    </div>
  </div>
</footer>
