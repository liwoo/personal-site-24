---
/**
 * Author card at the end of every post. Static, no third-party script.
 */
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import { quickCall } from '~/data/booking';
import avatar from '~/assets/images/dp.png';
---

<aside class="glass rounded-xl px-4 sm:px-6 py-5" aria-labelledby="author-name">
  <p class="terminal-label">author</p>
  <div class="mt-3 flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex items-center gap-4 flex-1 min-w-0">
      <Image
        src={avatar}
        alt="Jeremiah Chienda"
        width={56}
        height={56}
        densities={[1, 2]}
        class="w-14 h-14 shrink-0 rounded object-cover bg-gray-400 dark:bg-gray-700"
        loading="lazy"
      />
      <div class="min-w-0">
        <p id="author-name" class="font-semibold text-default leading-snug">Jeremiah Chienda</p>
        <p class="mt-0.5 text-sm text-muted leading-snug">AI engineer. I built IremboAI for 12M Rwandans.</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-4 shrink-0">
      <Button href={quickCall.href} variant="primary" class="rounded-md" data-open-book-me aria-haspopup="dialog">
        Book_me
      </Button>
      <a href="/about" class="btn-link text-xs">About</a>
    </div>
  </div>
</aside>
