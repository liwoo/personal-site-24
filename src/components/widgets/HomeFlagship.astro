---
import Button from '~/components/ui/Button.astro';
import { projects } from '~/data/projects';

// IremboAI, the build recruiters ask about first. The cover comes from the
// project entry so the two never drift.
const irembo = projects.find((p) => p.slug === 'irembo-ai');
const cover = typeof irembo?.image?.src === 'string' ? irembo.image.src : undefined;
const story = '/ai-for-12-million-citizens';
---

<section id="flagship" class="container py-16 lg:py-24">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 items-center">
    {
      cover && (
        <a href={story} class="flagship-cover glass glass-sheen block w-full lg:w-1/2 shrink-0 rounded-xl p-1.5" data-astro-prefetch>
          <img
            src={cover}
            alt="An Irembo agent helping a citizen at a service desk"
            class="w-full aspect-[4/3] object-cover rounded-lg bg-gray-400 dark:bg-slate-700"
            loading="lazy"
            width="800"
            height="600"
          />
        </a>
      )
    }
    <div class="w-full lg:w-1/2">
      <p class="terminal-label">flagship</p>
      <h2 class="mt-3 text-4xl md:text-6xl font-bold leading-tighter tracking-tighter font-heading text-heading">
        IremboAI
      </h2>
      <p class="mt-4 text-base md:text-xl text-muted">
        Rwanda's government, answerable in Kinyarwanda, English or French. I led the AI team that built it.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs">
        <li class="glass px-3 py-1">12M citizens</li>
        <li class="glass px-3 py-1">3 languages</li>
        <li class="glass px-3 py-1">95% accuracy &amp; tone</li>
      </ul>
      <div class="mt-6">
        <Button href={story} variant="tertiary" class="px-0 md:px-0">How we built it</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .flagship-cover {
    transition: transform 0.4s ease-out;
  }
  .flagship-cover:hover {
    transform: translateY(-4px);
  }
</style>
