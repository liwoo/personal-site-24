---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import { Icon } from 'astro-icon/components';

import type { Post } from '~/types';
import Bio from '../widgets/Bio.astro';
import { NewsletterInline } from '../widgets/NewsletterInline';
import Related from './Related.astro';

export interface Props {
  post: Post;
  url: string | URL;
  /** Picked by the page (shared with its Dev Mode `dev` object). */
  related?: Post[];
}

const { post, url, related = [] } = Astro.props;
const { Content } = post;
---

<article>
  {
    post.image && (
      <div class="container-article pb-8">
        <div class="glass glass-sheen rounded-xl p-1.5">
          <Image
            src={post.image}
            class="w-full aspect-[16/9] object-cover rounded-lg bg-gray-400 dark:bg-gray-700"
            widths={[400, 768]}
            sizes="(max-width: 768px) 100vw, 768px"
            alt={post?.excerpt || ''}
            width={768}
            height={432}
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )
  }

  <div class="container-article">
    <NewsletterInline
      client:visible
      category={post.category ?? 'general'}
      title="Enjoying this? Get the next one."
      blurb="New deep dives in your inbox. No spam, unsubscribe anytime."
    />
  </div>

  <div
    class="post-content drop-cap container-article prose prose-lg lg:prose-xl code-block prose-pre:pt-12 prose-pre:border prose-pre:border-gray-500/20 dark:prose-invert prose-headings:text-primary prose-img:w-full prose-img:border prose-img:border-gray-500/20 prose-img:hover:border-primary prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary prose-a:underline-offset-4 mt-10 prose-headings:scroll-mt-[80px] prose-blockquote:bg-card prose-blockquote:p-4 prose-blockquote:border-primary/50 prose-h3:text-default prose-h4:text-muted prose-hr:border-primary/20"
  >
    {Content ? <Content /> : <Fragment set:html={post.content || ''} />}
  </div>

  <footer class="container-article mt-12 flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <PostTags tags={post.tags} />
      <SocialShare url={url} text={post.title} class="flex items-center shrink-0 text-default" />
    </div>
    {
      post.commentLink && (
        <a
          href={post.commentLink}
          target="_blank"
          rel="noopener noreferrer"
          class="self-start inline-flex items-center gap-2 text-xs uppercase tracking-widest text-secondary hover:text-primary focus-visible:text-primary transition-colors"
        >
          Discuss on <Icon name="tabler:brand-x" class="w-4 h-4" aria-hidden="true" />
          <span class="sr-only">(X)</span>
        </a>
      )
    }
    <Bio />
  </footer>

  {
    related.length > 0 && (
      <div class="container-lg pt-16 lg:pt-20">
        <Related posts={related} />
      </div>
    )
  }
</article>

<script>
  // Extract syntax-highlighted tokens from Shiki DOM
  type Token = { text: string; color: string };
  type TokenLine = Token[];

  function extractHighlightedLines(preEl: HTMLPreElement): TokenLine[] {
    const isDark = document.documentElement.classList.contains('dark');
    const defaultColor = isDark ? '#e1e4e8' : '#24292e';
    const lines: TokenLine[] = [];

    const lineEls = preEl.querySelectorAll('.line');
    if (lineEls.length === 0) {
      // Fallback: plain text
      const text = preEl.textContent || '';
      return text.split('\n').map(line => [{ text: line, color: defaultColor }]);
    }

    lineEls.forEach(lineEl => {
      const tokens: Token[] = [];
      const spans = lineEl.querySelectorAll('span');
      if (spans.length === 0) {
        tokens.push({ text: lineEl.textContent || '', color: defaultColor });
      } else {
        spans.forEach(span => {
          const style = span.getAttribute('style') || '';
          let color = defaultColor;
          if (isDark) {
            const darkMatch = style.match(/--shiki-dark:\s*(#[0-9a-fA-F]+)/);
            if (darkMatch) color = darkMatch[1];
          } else {
            const lightMatch = style.match(/(?:^|;)\s*color:\s*(#[0-9a-fA-F]+)/);
            if (lightMatch) color = lightMatch[1];
          }
          const text = span.textContent || '';
          if (text) tokens.push({ text, color });
        });
      }
      lines.push(tokens);
    });

    // Trim trailing empty lines
    while (lines.length > 0 && lines[lines.length - 1].every(t => t.text.trim() === '')) {
      lines.pop();
    }
    return lines;
  }

  // Render code snippet to a branded PNG via Canvas with syntax highlighting
  function renderCodeImage(preEl: HTMLPreElement, langLabel: string): Promise<Blob> {
    return new Promise((resolve, reject) => {
      const scale = 2;
      const padding = 40 * scale;
      const lineHeight = 18 * scale;
      const fontSize = 13 * scale;
      const headerHeight = 36 * scale;
      const footerHeight = 32 * scale;
      const charW = fontSize * 0.6;
      const maxLineChars = 72;
      const lineNumWidth = 4 * charW;
      const codeX = padding * 0.4 + lineNumWidth;

      const highlightedLines = extractHighlightedLines(preEl);

      const codeHeight = highlightedLines.length * lineHeight + padding;
      const canvasW = maxLineChars * charW + codeX + padding;
      const canvasH = headerHeight + codeHeight + footerHeight + padding;

      const canvas = document.createElement('canvas');
      canvas.width = canvasW;
      canvas.height = canvasH;
      const ctx = canvas.getContext('2d');
      if (!ctx) return reject(new Error('No canvas context'));

      const isDark = document.documentElement.classList.contains('dark');
      const bg = isDark ? '#1a1a1a' : '#fafafa';
      const codeBg = isDark ? '#24292e' : '#ffffff';
      const mutedColor = isDark ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.25)';
      const accentColor = '#d89121';
      const fontStack = '"Space Mono", "Courier New", monospace';

      // Background
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, canvasW, canvasH);

      // Header bar
      ctx.fillStyle = accentColor;
      ctx.fillRect(0, 0, canvasW, headerHeight);
      ctx.fillStyle = '#000';
      ctx.font = `bold ${11 * scale}px ${fontStack}`;
      ctx.textBaseline = 'middle';
      ctx.fillText(`> ${langLabel}_`, padding * 0.6, headerHeight / 2);
      const siteText = 'chienda.com';
      const siteWidth = ctx.measureText(siteText).width;
      ctx.fillText(siteText, canvasW - padding * 0.6 - siteWidth, headerHeight / 2);

      // Code area
      const codeY = headerHeight;
      ctx.fillStyle = codeBg;
      ctx.fillRect(0, codeY, canvasW, codeHeight);

      // Subtle border
      ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
      ctx.lineWidth = 1 * scale;
      ctx.strokeRect(0, codeY, canvasW, codeHeight);

      // Line number gutter separator
      ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
      ctx.beginPath();
      ctx.moveTo(codeX - charW * 0.5, codeY);
      ctx.lineTo(codeX - charW * 0.5, codeY + codeHeight);
      ctx.stroke();

      // Render each line with syntax colors
      ctx.font = `${fontSize}px ${fontStack}`;
      ctx.textBaseline = 'top';

      for (let i = 0; i < highlightedLines.length; i++) {
        const y = codeY + padding * 0.5 + i * lineHeight;

        // Line number
        const lineNum = String(i + 1).padStart(3, ' ');
        ctx.fillStyle = mutedColor;
        ctx.fillText(lineNum, padding * 0.4, y);

        // Tokens with syntax colors
        let x = codeX;
        for (const token of highlightedLines[i]) {
          ctx.fillStyle = token.color;
          ctx.fillText(token.text, x, y);
          x += ctx.measureText(token.text).width;
        }
      }

      // Footer
      const footerY = codeY + codeHeight;
      ctx.fillStyle = bg;
      ctx.fillRect(0, footerY, canvasW, footerHeight + padding);

      ctx.fillStyle = mutedColor;
      ctx.font = `${10 * scale}px ${fontStack}`;
      ctx.textBaseline = 'top';
      ctx.fillText(`>_ chienda.com  ·  ${window.location.pathname}`, padding * 0.6, footerY + 10 * scale);

      // Bottom accent line
      ctx.fillStyle = accentColor;
      ctx.fillRect(0, canvasH - 3 * scale, canvasW, 3 * scale);

      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Failed to create blob'));
      }, 'image/png');
    });
  }

  // Code block toolbar: language label, copy, share
  function initCodeToolbars() {
    const langMap: Record<string, string> = {
      python: 'Python', py: 'Python', javascript: 'JavaScript', js: 'JavaScript',
      typescript: 'TypeScript', ts: 'TypeScript', json: 'JSON', bash: 'Bash',
      shell: 'Shell', sql: 'SQL', html: 'HTML', css: 'CSS', yaml: 'YAML',
      yml: 'YAML', rust: 'Rust', go: 'Go', java: 'Java', csharp: 'C#',
      cs: 'C#', cpp: 'C++', c: 'C', ruby: 'Ruby', php: 'PHP', swift: 'Swift',
      kotlin: 'Kotlin', dart: 'Dart', jsx: 'JSX', tsx: 'TSX', mdx: 'MDX',
      xml: 'XML', toml: 'TOML', ini: 'INI', dockerfile: 'Dockerfile',
      graphql: 'GraphQL', r: 'R', lua: 'Lua', scala: 'Scala',
      plaintext: 'Output', text: 'Output',
    };

    document.querySelectorAll('.code-block pre').forEach((pre) => {
      if (pre.querySelector('.code-toolbar')) return;

      const langKey = pre.getAttribute('data-language') || '';
      const langLabel = langMap[langKey] || (langKey ? langKey.toUpperCase() : 'CODE');
      const code = pre.querySelector('code');
      const codeText = code?.textContent || pre.textContent || '';

      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      toolbar.innerHTML = `
        <span class="code-lang">&gt; ${langLabel}_</span>
        <span class="code-actions">
          <button class="code-copy-btn" aria-label="Copy code">COPY</button>
          <button class="code-share-btn" aria-label="Share snippet">SHARE</button>
        </span>
      `;
      pre.insertBefore(toolbar, pre.firstChild);

      // Copy
      toolbar.querySelector('.code-copy-btn')!.addEventListener('click', async () => {
        const btn = toolbar.querySelector('.code-copy-btn') as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(codeText);
          btn.textContent = 'COPIED';
          setTimeout(() => btn.textContent = 'COPY', 2000);
        } catch {
          btn.textContent = 'FAILED';
          setTimeout(() => btn.textContent = 'COPY', 2000);
        }
      });

      // Share — render to canvas image
      toolbar.querySelector('.code-share-btn')!.addEventListener('click', async () => {
        const btn = toolbar.querySelector('.code-share-btn') as HTMLButtonElement;
        btn.textContent = '...';

        try {
          const blob = await renderCodeImage(pre as HTMLPreElement, langLabel);

          // Mobile: native share with image file
          if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
            const file = new File([blob], `snippet-${langKey || 'code'}.png`, { type: 'image/png' });
            if (navigator.canShare?.({ files: [file] })) {
              await navigator.share({
                files: [file],
                title: `${langLabel} snippet from chienda.com`,
                url: window.location.href,
              });
              btn.textContent = 'SHARE';
              return;
            }
          }

          // Desktop: download the image
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `snippet-${langKey || 'code'}.png`;
          a.click();
          URL.revokeObjectURL(url);
          btn.textContent = 'SAVED';
          setTimeout(() => btn.textContent = 'SHARE', 2000);
        } catch {
          btn.textContent = 'FAILED';
          setTimeout(() => btn.textContent = 'SHARE', 2000);
        }
      });
    });
  }

  // Pull-quote toolbar: copy + share, plus Schema.org Quotation markup for SEO
  function initQuoteToolbars() {
    const canonical =
      document.querySelector('link[rel="canonical"]')?.getAttribute('href') || window.location.href;
    const pageTitle = document.title.replace(/\s*[|—-].*$/, '').trim();

    document.querySelectorAll('.post-content blockquote').forEach((bq) => {
      // Skip embedded tweets and already-processed quotes
      if (bq.classList.contains('twitter-tweet') || bq.querySelector('.quote-toolbar')) return;

      const quoteText = (bq.textContent || '').trim();
      if (!quoteText) return;

      // SEO: mark the quote up as a Schema.org Quotation
      bq.setAttribute('itemscope', '');
      bq.setAttribute('itemtype', 'https://schema.org/Quotation');
      bq.setAttribute('cite', canonical);
      const body = bq.querySelector('p') || bq;
      body.setAttribute('itemprop', 'text');
      const creator = document.createElement('meta');
      creator.setAttribute('itemprop', 'creator');
      creator.setAttribute('content', 'Jeremiah Chienda');
      bq.appendChild(creator);

      const shareText = `“${quoteText}”`;

      const toolbar = document.createElement('div');
      toolbar.className = 'quote-toolbar';
      toolbar.setAttribute('contenteditable', 'false');
      toolbar.innerHTML = `
        <button class="quote-copy-btn" aria-label="Copy quote">COPY</button>
        <button class="quote-share-btn" aria-label="Share quote">SHARE</button>
      `;
      bq.appendChild(toolbar);

      // Copy — quote text plus a source link, ready to paste
      toolbar.querySelector('.quote-copy-btn')!.addEventListener('click', async () => {
        const btn = toolbar.querySelector('.quote-copy-btn') as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(`${shareText}\n\n— ${pageTitle}\n${canonical}`);
          btn.textContent = 'COPIED';
          setTimeout(() => (btn.textContent = 'COPY'), 2000);
        } catch {
          btn.textContent = 'FAILED';
          setTimeout(() => (btn.textContent = 'COPY'), 2000);
        }
      });

      // Share — native share sheet on mobile, X intent on desktop
      toolbar.querySelector('.quote-share-btn')!.addEventListener('click', async () => {
        const btn = toolbar.querySelector('.quote-share-btn') as HTMLButtonElement;
        try {
          if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
            await navigator.share({ text: shareText, url: canonical });
            return;
          }
          const intent =
            'https://twitter.com/intent/tweet?text=' +
            encodeURIComponent(shareText) +
            '&url=' +
            encodeURIComponent(canonical) +
            '&via=liwucodes';
          window.open(intent, '_blank', 'noopener,width=550,height=420');
        } catch {
          btn.textContent = 'FAILED';
          setTimeout(() => (btn.textContent = 'SHARE'), 2000);
        }
      });
    });
  }

  // astro:page-load fires on the first load and after every client-side
  // navigation. Both init functions skip blocks they've already processed.
  document.addEventListener('astro:page-load', () => {
    initCodeToolbars();
    initQuoteToolbars();
  });
</script>
