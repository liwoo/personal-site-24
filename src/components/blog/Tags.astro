---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from '~/utils/config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  isCategory?: boolean;
}

const { tags, class: className, isCategory = false } = Astro.props;
const linked = isCategory ? APP_BLOG?.category?.isEnabled : APP_BLOG?.tag?.isEnabled;
---

{
  tags && tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-2 text-xs', className]} aria-label={isCategory ? 'Categories' : 'Tags'}>
      {tags.map((tag) => (
        <li>
          {linked ? (
            <a
              href={getPermalink(tag, isCategory ? 'category' : 'tag')}
              class="glass inline-block px-3 py-1 text-muted hover:text-primary focus-visible:text-primary transition-colors"
            >
              #{tag}
            </a>
          ) : (
            <span class="glass inline-block px-3 py-1 text-muted">#{tag}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
