---
import BlogPostList from './BlogPostList.astro';
import type { Post } from '~/types';

type Props = {
  /** Already picked and trimmed by the page, so Dev Mode shows the same list. */
  posts?: Post[];
};

const { posts = [] } = Astro.props;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-title">
      <div class="flex items-end justify-between gap-4 mb-6">
        <div>
          <p class="terminal-label">related</p>
          <h2 id="related-title" class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">
            Keep reading
          </h2>
        </div>
        <a href="/blog" class="btn-link text-xs shrink-0">
          All articles
        </a>
      </div>
      <BlogPostList posts={posts} />
    </section>
  )
}
