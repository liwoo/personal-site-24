---
import { UI } from '~/utils/config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme }}>
  (function () {
  if (window.basic_script) {
    return;
  }

  window.basic_script = true;

  function applyTheme(theme) {
    toggleCompanyLogo(theme);
    toggleTweetCard();
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }
  
  function animateHeroGrid() {
    //eg data-square="sq-1"
    const squares = document.querySelectorAll('[data-square]');
    //
    // squares.forEach((square) => {
    //   // const currentOpacity = square.classList.add('opacity-100');
    //   const timePeriod = Math.floor(Math.random() * 1500) + 500;
    //   console.log({currentOpacity});
    // 
    // })
    //
    //randomly flick the opacity of 20 square within 2 seconds
    // setInterval(() => {
    //   const randomSquares = Array.from({ length: 20 }, () => squares[Math.floor(Math.random() * squares.length)]);
    //   randomSquares.forEach((square) => {
    //     const currentOpacity = square.style.opacity;
    //     square.style.opacity = 100;
    //     setTimeout(() => {
    //       square.style.opacity = currentOpacity;
    //     }, 500);
    //   });
    // }, 2000);
  }

  //toggle animation classes on view
  function toggleAnimationOnView() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const shouldReset = entry.target.dataset.reset;

        if (entry.isIntersecting) {
          const animation = entry.target.dataset.animation;
          entry.target.classList.add(animation);
        }

        if (entry.isIntersecting && !shouldReset) {
          observer.unobserve(entry.target);
        }

        if (!entry.isIntersecting && shouldReset) {
          const animation = entry.target.dataset.animation;
          entry.target.classList.remove(animation);
        }
      });
    });

    //select all with data-animation
    document.querySelectorAll('[data-animation]').forEach((elem) => {
      observer.observe(elem);
    });
  }

  function toggleTweetCard() {
    const html = document.querySelector('html');
    const tweetCards = document.querySelectorAll('.tweets');

    const ovserver = new MutationObserver((mutations) => {
      //listen to html class changes
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          tweetCards.forEach((tweetCard) => {
            // tweetCard.classList.toggle('hidden', true);
            if (html.classList.contains('dark') && tweetCard.classList.contains('dark')) {
              tweetCard.classList.toggle('hidden', false);
            } else if (!html.classList.contains('dark') && tweetCard.classList.contains('light')) {
              tweetCard.classList.toggle('hidden', false);
            } else {
              tweetCard.classList.toggle('hidden', true);
            }
          });
        }
      });
    });

    ovserver.observe(html, {
      attributes: true,
    });
  }

  function toggleCompanyLogo(theme) {
    const companyLogo = document.querySelectorAll('[data-img-type]');

    if (theme === 'dark') {
      for (let i = 0; i < companyLogo.length; i++) {
        companyLogo[i].src = companyLogo[i].src = companyLogo[i].dataset.imgLight;
      }
    } else {
      for (let i = 0; i < companyLogo.length; i++) {
        companyLogo[i].src = companyLogo[i].src = companyLogo[i].dataset.imgDark;
      }
    }
  }

  function applyDevMode(enabled) {
    const html = document.documentElement;
    html.classList.toggle('dev-mode', enabled);
    document.querySelectorAll('[data-aw-toggle-dev-mode]').forEach((btn) => {
      btn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
    });
    // Dev Mode replaces the whole page with its artistic JSON document; scroll
    // to the top so visitors land at the header of the new view.
    if (enabled) {
      updateDevPath();
      highlightDevNav();
      buildDevSections();
      runTypewriters();
      initBlogSearch();
      window.scrollTo(0, 0);
    }
  }

  // Real-time, debounced filter over the blog post list (no submit button).
  function initBlogSearch() {
    const input = document.querySelector('[data-aj-blog-search]');
    if (!input || input.dataset.bound === '1') return;
    input.dataset.bound = '1';
    const postsSec = document.querySelector('.aj-doc [data-aj-key="posts"]');
    const countEl = document.querySelector('[data-aj-search-count]');
    let timer;
    const run = () => {
      const q = input.value.trim().toLowerCase();
      const items = postsSec ? postsSec.querySelectorAll('.aj-item') : [];
      let shown = 0;
      let firstMatch = null;
      items.forEach((it) => {
        const match = !q || (it.textContent || '').toLowerCase().includes(q);
        it.style.display = match ? '' : 'none';
        if (match) {
          shown++;
          if (!firstMatch) firstMatch = it;
        }
      });
      if (!countEl) return;
      countEl.onclick = null;
      countEl.classList.remove('link');
      if (!q) {
        countEl.textContent = '';
      } else if (shown === 0) {
        countEl.textContent = '// no matches';
      } else {
        // The count hyperlinks to (scrolls to) the first matching article.
        countEl.textContent = '// ' + shown + ' match' + (shown === 1 ? '' : 'es') + ' → jump to article';
        countEl.classList.add('link');
        countEl.onclick = () => firstMatch && firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    });
  }

  // Lightbox: tap/click a framed image to expand it full screen.
  function openDevLightbox(src, alt) {
    let ov = document.getElementById('aj-lightbox');
    if (!ov) {
      ov = document.createElement('div');
      ov.id = 'aj-lightbox';
      ov.className = 'aj-lightbox';
      ov.innerHTML = '<img alt="" /><button class="aj-lightbox-close" aria-label="Close">✕</button>';
      document.body.appendChild(ov);
      ov.addEventListener('click', () => ov.classList.remove('open'));
    }
    const img = ov.querySelector('img');
    img.src = src;
    img.alt = alt || '';
    ov.classList.add('open');
  }
  document.addEventListener(
    'click',
    function (e) {
      const t = e.target;
      const img = t && t.closest ? t.closest('.aj-figure img, .aj-figure-block img') : null;
      if (img && document.documentElement.classList.contains('dev-mode')) {
        e.preventDefault();
        openDevLightbox(img.getAttribute('src'), img.getAttribute('alt'));
      }
    },
    false
  );
  // --- Global keyboard navigation ------------------------------------------
  // Make the whole site drivable from the keyboard:
  //   Cmd/Ctrl + Shift + 1–9(0)  jump to the Nth primary nav item / section
  //   /                          focus the page search
  //   ?                          toggle the shortcuts cheatsheet
  //   Esc                        close menus & overlays
  // Digit detection uses e.code so it is keyboard-layout independent (with
  // Shift held, e.key for the "1" key is "!", not "1").
  function ajNavItems() {
    const dev = document.documentElement.classList.contains('dev-mode');
    const nodes = dev
      ? document.querySelectorAll('.dmj-nav-item')
      : document.querySelectorAll('#header nav a[href]');
    return Array.prototype.slice.call(nodes);
  }
  function ajIsTyping(el) {
    return !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
  }
  function ajFocusSearch() {
    const el =
      document.querySelector('[data-aj-blog-search]') ||
      document.getElementById('search-blog') ||
      document.querySelector('input[type="search"]');
    if (el && el.offsetParent !== null) {
      el.focus();
      if (el.select) el.select();
      return true;
    }
    return false;
  }
  const AJ_SHORTCUTS = [
    { keys: '⌘/Ctrl ⇧ 1–9', label: 'Jump to a nav section' },
    { keys: '/', label: 'Focus search' },
    { keys: 'Tab', label: 'Move through links & fields' },
    { keys: '?', label: 'Toggle this help' },
    { keys: 'Esc', label: 'Close menus & overlays' },
  ];
  function ajBuildHelp() {
    let ov = document.getElementById('dmj-help');
    if (ov) return ov;
    ov = document.createElement('div');
    ov.id = 'dmj-help';
    ov.className = 'dmj-help';
    ov.setAttribute('role', 'dialog');
    ov.setAttribute('aria-modal', 'true');
    ov.setAttribute('aria-label', 'Keyboard shortcuts');
    ov.innerHTML =
      '<div class="dmj-help-panel">' +
      '<div class="dmj-help-title">Keyboard shortcuts' +
      '<button type="button" class="dmj-help-close" data-dmj-help-close aria-label="Close">esc</button></div>' +
      AJ_SHORTCUTS.map(function (s) {
        return '<div class="dmj-help-row"><span>' + s.label + '</span><kbd>' + s.keys + '</kbd></div>';
      }).join('') +
      '</div>';
    document.body.appendChild(ov);
    ov.addEventListener('click', function (e) {
      if (e.target === ov || (e.target.closest && e.target.closest('[data-dmj-help-close]'))) ajToggleHelp(false);
    });
    return ov;
  }
  function ajToggleHelp(force) {
    const ov = ajBuildHelp();
    const open = typeof force === 'boolean' ? force : !ov.classList.contains('open');
    ov.classList.toggle('open', open);
  }

  document.addEventListener('keydown', function (e) {
    const mod = e.metaKey || e.ctrlKey;
    if (mod && e.shiftKey && !e.altKey) {
      const m = /^Digit([0-9])$/.exec(e.code);
      if (m) {
        const n = parseInt(m[1], 10);
        const idx = n === 0 ? 9 : n - 1;
        const target = ajNavItems()[idx];
        if (target) {
          e.preventDefault();
          const href = target.getAttribute('href');
          if (href) window.location.assign(href);
        }
        return;
      }
    }
    if (e.key === 'Escape') {
      document.getElementById('aj-lightbox')?.classList.remove('open');
      document.getElementById('dmj-help')?.classList.remove('open');
      document.querySelector('[data-dmj-nav]')?.classList.remove('open');
      return;
    }
    if (ajIsTyping(e.target)) return;
    if (e.key === '/' && !mod && !e.shiftKey) {
      if (ajFocusSearch()) e.preventDefault();
    } else if (e.key === '?') {
      e.preventDefault();
      ajToggleHelp();
    }
  });

  // Open the cheatsheet from the sidebar hint; make the skip link move focus.
  document.addEventListener('click', function (e) {
    const t = e.target;
    if (!t || !t.closest) return;
    if (t.closest('[data-dmj-help-open]')) {
      e.preventDefault();
      ajToggleHelp(true);
      return;
    }
    if (t.closest('[data-dmj-skip]')) {
      const main = document.getElementById('dev-main');
      if (main) setTimeout(() => main.focus(), 0);
    }
  });

  // Build the contextual "on this page" section index in the sidebar, with a
  // scrollspy that highlights the section currently in view.
  let devSpyObserver = null;
  function buildDevSections() {
    const container = document.querySelector('[data-dmj-sections]');
    const wrap = document.querySelector('[data-dmj-context]');
    if (!container) return;
    const list = Array.prototype.slice.call(document.querySelectorAll('.aj-doc [data-aj-key][id]'));
    container.innerHTML = '';
    if (!list.length) {
      if (wrap) wrap.hidden = true;
      return;
    }
    if (wrap) wrap.hidden = false;
    list.forEach((sec, i) => {
      const key = sec.getAttribute('data-aj-key') || 'sec' + i;
      const a = document.createElement('a');
      a.className = 'dmj-nav-sec';
      a.href = '#' + sec.id;
      a.dataset.spy = sec.id;
      a.innerHTML =
        '<span class="dmj-nav-sec-idx">' + String(i).padStart(2, '0') + '</span><span>' + key + '</span>';
      container.appendChild(a);
    });
    if (devSpyObserver) devSpyObserver.disconnect();
    devSpyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            container.querySelectorAll('.dmj-nav-sec').forEach((x) => {
              x.classList.toggle('active', x.dataset.spy === en.target.id);
            });
          }
        });
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 }
    );
    list.forEach((sec) => devSpyObserver.observe(sec));
  }

  // Functional Dev Mode forms — submit via fetch to their data-aj-endpoint.
  function handleDevFormSubmit(e) {
    const form = e.target;
    if (!form || !form.matches || !form.matches('form[data-aj-endpoint]')) return;
    e.preventDefault();
    const endpoint = form.getAttribute('data-aj-endpoint');
    const status = form.querySelector('.aj-form-status');
    const payload = {};
    form.querySelectorAll('input, textarea').forEach((el) => {
      if (el.name) payload[el.name] = el.value;
    });
    const cat = form.getAttribute('data-aj-category');
    if (cat) payload.category = cat;
    const setStatus = (cls, text) => {
      if (status) {
        status.className = 'aj-form-status ' + cls;
        status.textContent = text;
      }
    };
    setStatus('', '> sending…');
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(async (r) => {
        const data = await r.json().catch(() => ({}));
        if (r.ok) {
          setStatus('ok', '✓ ' + (form.getAttribute('data-aj-success') || data.message || 'Done.'));
          form.reset();
        } else {
          setStatus('err', '✗ ' + (data.message || 'Something went wrong.'));
        }
      })
      .catch(() => setStatus('err', '✗ Network error — please try again.'));
  }
  document.addEventListener('submit', handleDevFormSubmit, true);

  // Render the current route as a file path in the fixed path bar.
  function updateDevPath() {
    const target = document.querySelector('[data-dmj-path]');
    if (!target) {
      return;
    }
    const parts = window.location.pathname.split('/').filter(Boolean);
    target.textContent = parts.length ? parts.join(' / ') : 'index';
  }

  // Mark the active route in the left tmux nav (parent route matches sub-pages).
  function highlightDevNav() {
    const here = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.dmj-nav-item').forEach((item) => {
      const route = (item.getAttribute('data-route') || '').replace(/\/$/, '') || '/';
      const active = route === '/' ? here === '/' : here === route || here.startsWith(route + '/');
      item.classList.toggle('active', active);
    });
  }

  // Typewriter: type out any [data-text] element (respects reduced motion).
  function runTypewriters() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.aj-type[data-text]').forEach((el) => {
      if (el.dataset.typed === '1') {
        return;
      }
      el.dataset.typed = '1';
      const text = el.getAttribute('data-text') || '';
      if (reduce) {
        el.textContent = text;
        el.classList.add('aj-type--done');
        return;
      }
      el.textContent = '';
      let i = 0;
      const tick = () => {
        el.textContent = text.slice(0, i);
        i += 1;
        if (i <= text.length) {
          setTimeout(tick, 24);
        } else {
          el.classList.add('aj-type--done');
        }
      };
      setTimeout(tick, 450);
    });
  }

  const initDevMode = function () {
    // Dev Mode is the default view; only an explicit 'false' opts out.
    applyDevMode(localStorage.devMode !== 'false');
  };

  const initTheme = function () {
    if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
      applyTheme(defaultTheme.replace(':only', ''));
    } else if (
      localStorage.theme === 'dark' ||
      (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      applyTheme('dark');
    } else {
      applyTheme('light');
    }
  };
  initTheme();
  initDevMode();

  function attachEvent(selector, event, fn) {
    const matches = typeof selector === 'string' ? document.querySelectorAll(selector) : selector;
    if (matches && matches.length) {
      matches.forEach((elem) => {
        elem.addEventListener(event, (e) => fn(e, elem), false);
      });
    }
  }

  const onLoad = function () {
    animateHeroGrid();
    toggleAnimationOnView();
    let lastKnownScrollPosition = window.scrollY;
    let ticking = true;

    const searchBlog = document.getElementById('search-blog');
    if (searchBlog) {
      searchBlog.addEventListener('keyup', () => {
        const searchValue = searchBlog.value.toLowerCase();
        const url = new URL(window.location.href);
        if (searchValue === '') {
          url.searchParams.delete('q');
        } else {
          url.searchParams.set('q', searchValue);
        }
        window.history.replaceState({}, '', url);
        //toggle visibility of #server-posts
        const serverPosts = document.getElementById('server-posts');
        if (serverPosts) {
          serverPosts.classList.toggle('hidden', searchValue !== '');
        }

        const pagination = document.getElementById('pagination');
        if (pagination) {
          pagination.classList.toggle('hidden', searchValue !== '');
        }

        const clientPosts = document.getElementById('client-posts');
        if (clientPosts) {
          clientPosts.classList.toggle('hidden', searchValue === '');
        }
      });
    }

    attachEvent('#header nav', 'click', function () {
      document.querySelector('[data-aw-toggle-menu]')?.classList.remove('expanded');
      document.body.classList.remove('overflow-hidden');
      document.getElementById('header')?.classList.remove('h-screen');
      document.getElementById('header')?.classList.remove('expanded');
      document.getElementById('header')?.classList.remove('bg-page');
      document.querySelector('#header nav')?.classList.add('hidden');
      document.querySelector('#header > div > div:last-child')?.classList.add('hidden');
    });

    attachEvent('[data-aw-toggle-menu]', 'click', function (_, elem) {
      elem.classList.toggle('expanded');
      document.body.classList.toggle('overflow-hidden');
      document.getElementById('header')?.classList.toggle('expanded');
      document.getElementById('header')?.classList.toggle('bg-page');
      document.querySelector('#header nav')?.classList.toggle('hidden');
      document.querySelector('#header > div > div:last-child')?.classList.toggle('hidden');
    });

    attachEvent('[data-aw-toggle-color-scheme]', 'click', function () {
      if (defaultTheme.endsWith(':only')) {
        return;
      }
      document.documentElement.classList.toggle('dark');
      localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      toggleCompanyLogo(localStorage.theme);
    });

    attachEvent('[data-aw-toggle-dev-mode]', 'click', function () {
      const enabled = !document.documentElement.classList.contains('dev-mode');
      localStorage.devMode = enabled ? 'true' : 'false';
      applyDevMode(enabled);
    });

    attachEvent('[data-dmj-hamburger]', 'click', function (_, elem) {
      const nav = document.querySelector('[data-dmj-nav]');
      if (!nav) return;
      const open = nav.classList.toggle('open');
      elem.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // Close the mobile nav after following a link (route or in-page section).
    attachEvent('.dmj-nav-item, .dmj-nav-sec', 'click', function () {
      document.querySelector('[data-dmj-nav]')?.classList.remove('open');
    });

    // Click-to-copy body text (bio / article / code).
    attachEvent('[data-aj-copy-text]', 'click', function (_, elem) {
      const container = elem.closest('.aj-copyable, .aj-codeblock');
      const body = container?.querySelector('.aj-copy-body');
      const text = body ? body.innerText : '';
      const label = elem.querySelector('.aj-copy-i');
      const done = () => {
        elem.classList.add('copied');
        const rest = elem.childNodes[elem.childNodes.length - 1];
        if (label) label.textContent = '✓';
        if (rest) rest.textContent = ' copied';
        setTimeout(() => {
          elem.classList.remove('copied');
          if (label) label.textContent = '⧉';
          if (rest) rest.textContent = ' copy';
        }, 1600);
      };
      if (navigator.clipboard && text) navigator.clipboard.writeText(text).then(done, done);
      else done();
    });

    // Share a code snippet as a branded PNG (reproduces the non-Dev toolbar).
    const AJ_TK = {
      'tk-com': '#8b949e', 'tk-str': '#a5d6ff', 'tk-num': '#79c0ff',
      'tk-lit': '#79c0ff', 'tk-kw': '#ff7b72', 'tk-punc': '#c9d1d9',
    };
    function extractDevCodeLines(codeEl) {
      const def = '#c9d1d9';
      const lines = [[]];
      const pushText = (text, color) => {
        const parts = String(text).split('\n');
        parts.forEach((p, idx) => {
          if (idx > 0) lines.push([]);
          if (p) lines[lines.length - 1].push({ text: p, color });
        });
      };
      codeEl.childNodes.forEach((node) => {
        if (node.nodeType === 3) pushText(node.textContent, def);
        else if (node.nodeType === 1) pushText(node.textContent, AJ_TK[node.className] || def);
      });
      while (lines.length && lines[lines.length - 1].every((t) => !t.text.trim())) lines.pop();
      return lines;
    }
    function renderDevCodeImage(codeEl, label) {
      const scale = 2;
      const pad = 40 * scale, lh = 18 * scale, fs = 13 * scale, header = 36 * scale, footer = 30 * scale;
      const charW = fs * 0.6, maxChars = 74, gutter = 4 * charW, codeX = pad * 0.4 + gutter;
      const rows = extractDevCodeLines(codeEl);
      const codeH = rows.length * lh + pad;
      const w = maxChars * charW + codeX + pad;
      const h = header + codeH + footer + pad;
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d');
      const font = '"Space Mono","Courier New",monospace';
      ctx.fillStyle = '#0a0a0c'; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#22d3ee'; ctx.fillRect(0, 0, w, header);
      ctx.fillStyle = '#0a0a0c'; ctx.font = `bold ${11 * scale}px ${font}`; ctx.textBaseline = 'middle';
      ctx.fillText('> ' + label + '_', pad * 0.6, header / 2);
      const site = 'chienda.com';
      ctx.fillText(site, w - pad * 0.6 - ctx.measureText(site).width, header / 2);
      const cy = header;
      ctx.fillStyle = '#0d1117'; ctx.fillRect(0, cy, w, codeH);
      ctx.strokeStyle = 'rgba(255,255,255,0.08)'; ctx.lineWidth = scale;
      ctx.beginPath(); ctx.moveTo(codeX - charW * 0.5, cy); ctx.lineTo(codeX - charW * 0.5, cy + codeH); ctx.stroke();
      ctx.font = `${fs}px ${font}`; ctx.textBaseline = 'top';
      for (let i = 0; i < rows.length; i++) {
        const y = cy + pad * 0.5 + i * lh;
        ctx.fillStyle = 'rgba(255,255,255,0.28)';
        ctx.fillText(String(i + 1).padStart(3, ' '), pad * 0.4, y);
        let x = codeX;
        for (const tok of rows[i]) { ctx.fillStyle = tok.color; ctx.fillText(tok.text, x, y); x += tok.text.length * charW; }
      }
      ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.font = `${10 * scale}px ${font}`; ctx.textBaseline = 'middle';
      ctx.fillText('// dev_mode · editorial_json', pad * 0.6, h - footer / 2);
      return new Promise((resolve) => canvas.toBlob((b) => resolve(b), 'image/png'));
    }
    attachEvent('[data-aj-code-share]', 'click', async function (_, btn) {
      const block = btn.closest('.aj-codeblock');
      const codeEl = block?.querySelector('.aj-copy-body code');
      if (!codeEl) return;
      const label = (block.getAttribute('data-language') || 'code').toUpperCase();
      const prev = btn.textContent;
      btn.textContent = '…';
      try {
        const blob = await renderDevCodeImage(codeEl, label);
        const file = new File([blob], 'snippet-' + (block.getAttribute('data-language') || 'code') + '.png', { type: 'image/png' });
        if (navigator.share && navigator.canShare?.({ files: [file] }) && /Mobi|Android/i.test(navigator.userAgent)) {
          await navigator.share({ files: [file], title: label + ' snippet · chienda.com', url: window.location.href });
          btn.textContent = prev;
        } else {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = file.name; a.click();
          URL.revokeObjectURL(url);
          btn.textContent = 'saved';
          setTimeout(() => (btn.textContent = prev), 1800);
        }
      } catch {
        btn.textContent = 'failed';
        setTimeout(() => (btn.textContent = prev), 1800);
      }
    });

    // Expandable CV detail on experience items (tap on mobile; hover on desktop).
    attachEvent('.aj-more-hint', 'click', function (_, elem) {
      const item = elem.closest('.aj-item');
      if (!item) return;
      const open = item.classList.toggle('open');
      elem.setAttribute('aria-expanded', open ? 'true' : 'false');
      const i = elem.querySelector('.aj-more-i');
      if (i) i.textContent = open ? '−' : '+';
    });

    // Copy-link share button.
    attachEvent('[data-aj-copy]', 'click', function (_, elem) {
      const url = elem.getAttribute('data-aj-copy') || window.location.href;
      const label = elem.querySelector('.aj-btn-label');
      const done = () => {
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied ✓';
          setTimeout(() => {
            label.textContent = prev;
          }, 1600);
        }
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done, done);
      } else {
        done();
      }
    });

    attachEvent('[data-aw-social-share]', 'click', function (_, elem) {
      const network = elem.getAttribute('data-aw-social-share');
      const url = encodeURIComponent(elem.getAttribute('data-aw-url'));
      const text = encodeURIComponent(elem.getAttribute('data-aw-text'));

      let href;
      switch (network) {
        case 'facebook':
          href = `https://www.facebook.com/sharer.php?u=${url}`;
          break;
        case 'twitter':
          href = `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
          break;
        case 'linkedin':
          href = `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`;
          break;
        case 'whatsapp':
          href = `https://wa.me/?text=${text}%20${url}`;
          break;
        case 'mail':
          href = `mailto:?subject=%22${text}%22&body=${text}%20${url}`;
          break;

        default:
          return;
      }

      //attach an input change event
      attachEvent('input', 'change', function (e) {
        console.log(e.target);
        const input = e.target;
        if (input.value) {
          href += `&${input.name}=${encodeURIComponent(input.value)}`;
        }
      });

      const newlink = document.createElement('a');
      newlink.target = '_blank';
      newlink.href = href;
      newlink.click();
    });

    function appyHeaderStylesOnScroll() {
      const header = document.querySelector('#header[data-aw-sticky-header]');
      if (!header) {
        ticking = false;
        return;
      }
      if (lastKnownScrollPosition > 60 && !header.classList.contains('scroll')) {
        header.classList.add('scroll');
      } else if (lastKnownScrollPosition <= 60 && header.classList.contains('scroll')) {
        header.classList.remove('scroll');
      }
      ticking = false;
    }
    appyHeaderStylesOnScroll();

    attachEvent([document], 'scroll', function () {
      lastKnownScrollPosition = window.scrollY;

      if (!ticking) {
        window.requestAnimationFrame(() => {
          appyHeaderStylesOnScroll();
        });
        ticking = true;
      }
    });
  };

  const onPageShow = function () {
    document.documentElement.classList.add('motion-safe:scroll-smooth');
    const elem = document.querySelector('[data-aw-toggle-menu]');
    if (elem) {
      elem.classList.remove('expanded');
    }
    document.body.classList.remove('overflow-hidden');
    document.getElementById('header')?.classList.remove('h-screen');
    document.getElementById('header')?.classList.remove('expanded');
    document.querySelector('#header nav')?.classList.add('hidden');
  };

  window.onload = onLoad;
  window.onpageshow = onPageShow;

  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initDevMode();
    animateHeroGrid();
    onLoad();
    onPageShow();
  });
  })();
</script>
