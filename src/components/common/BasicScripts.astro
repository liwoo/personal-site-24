---
import { UI } from '~/utils/config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme }}>
  (function () {
  if (window.basic_script) {
    return;
  }

  window.basic_script = true;

  function applyTheme(theme) {
    toggleCompanyLogo(theme);
    toggleTweetCard();
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }
  
  function animateHeroGrid() {
    //eg data-square="sq-1"
    const squares = document.querySelectorAll('[data-square]');
    //
    // squares.forEach((square) => {
    //   // const currentOpacity = square.classList.add('opacity-100');
    //   const timePeriod = Math.floor(Math.random() * 1500) + 500;
    //   console.log({currentOpacity});
    // 
    // })
    //
    //randomly flick the opacity of 20 square within 2 seconds
    // setInterval(() => {
    //   const randomSquares = Array.from({ length: 20 }, () => squares[Math.floor(Math.random() * squares.length)]);
    //   randomSquares.forEach((square) => {
    //     const currentOpacity = square.style.opacity;
    //     square.style.opacity = 100;
    //     setTimeout(() => {
    //       square.style.opacity = currentOpacity;
    //     }, 500);
    //   });
    // }, 2000);
  }

  //toggle animation classes on view
  function toggleAnimationOnView() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const shouldReset = entry.target.dataset.reset;

        if (entry.isIntersecting) {
          const animation = entry.target.dataset.animation;
          entry.target.classList.add(animation);
        }

        if (entry.isIntersecting && !shouldReset) {
          observer.unobserve(entry.target);
        }

        if (!entry.isIntersecting && shouldReset) {
          const animation = entry.target.dataset.animation;
          entry.target.classList.remove(animation);
        }
      });
    });

    //select all with data-animation
    document.querySelectorAll('[data-animation]').forEach((elem) => {
      observer.observe(elem);
    });
  }

  function toggleTweetCard() {
    const html = document.querySelector('html');
    const tweetCards = document.querySelectorAll('.tweets');

    const ovserver = new MutationObserver((mutations) => {
      //listen to html class changes
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          tweetCards.forEach((tweetCard) => {
            // tweetCard.classList.toggle('hidden', true);
            if (html.classList.contains('dark') && tweetCard.classList.contains('dark')) {
              tweetCard.classList.toggle('hidden', false);
            } else if (!html.classList.contains('dark') && tweetCard.classList.contains('light')) {
              tweetCard.classList.toggle('hidden', false);
            } else {
              tweetCard.classList.toggle('hidden', true);
            }
          });
        }
      });
    });

    ovserver.observe(html, {
      attributes: true,
    });
  }

  function toggleCompanyLogo(theme) {
    const companyLogo = document.querySelectorAll('[data-img-type]');

    if (theme === 'dark') {
      for (let i = 0; i < companyLogo.length; i++) {
        companyLogo[i].src = companyLogo[i].src = companyLogo[i].dataset.imgLight;
      }
    } else {
      for (let i = 0; i < companyLogo.length; i++) {
        companyLogo[i].src = companyLogo[i].src = companyLogo[i].dataset.imgDark;
      }
    }
  }

  function applyDevMode(enabled) {
    const html = document.documentElement;
    html.classList.toggle('dev-mode', enabled);
    document.querySelectorAll('[data-aw-toggle-dev-mode]').forEach((btn) => {
      btn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
    });
    // Dev Mode replaces the whole page with its artistic JSON document; scroll
    // to the top so visitors land at the header of the new view.
    if (enabled) {
      updateDevPath();
      highlightDevNav();
      buildDevSections();
      runTypewriters();
      window.scrollTo(0, 0);
    }
  }

  // Build the contextual "on this page" section index in the sidebar, with a
  // scrollspy that highlights the section currently in view.
  let devSpyObserver = null;
  function buildDevSections() {
    const container = document.querySelector('[data-dmj-sections]');
    const wrap = document.querySelector('[data-dmj-context]');
    if (!container) return;
    const list = Array.prototype.slice.call(document.querySelectorAll('.aj-doc [data-aj-key][id]'));
    container.innerHTML = '';
    if (!list.length) {
      if (wrap) wrap.hidden = true;
      return;
    }
    if (wrap) wrap.hidden = false;
    list.forEach((sec, i) => {
      const key = sec.getAttribute('data-aj-key') || 'sec' + i;
      const a = document.createElement('a');
      a.className = 'dmj-nav-sec';
      a.href = '#' + sec.id;
      a.dataset.spy = sec.id;
      a.innerHTML =
        '<span class="dmj-nav-sec-idx">' + String(i).padStart(2, '0') + '</span><span>' + key + '</span>';
      container.appendChild(a);
    });
    if (devSpyObserver) devSpyObserver.disconnect();
    devSpyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            container.querySelectorAll('.dmj-nav-sec').forEach((x) => {
              x.classList.toggle('active', x.dataset.spy === en.target.id);
            });
          }
        });
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 }
    );
    list.forEach((sec) => devSpyObserver.observe(sec));
  }

  // Functional Dev Mode forms — submit via fetch to their data-aj-endpoint.
  function handleDevFormSubmit(e) {
    const form = e.target;
    if (!form || !form.matches || !form.matches('form[data-aj-endpoint]')) return;
    e.preventDefault();
    const endpoint = form.getAttribute('data-aj-endpoint');
    const status = form.querySelector('.aj-form-status');
    const payload = {};
    form.querySelectorAll('input, textarea').forEach((el) => {
      if (el.name) payload[el.name] = el.value;
    });
    const cat = form.getAttribute('data-aj-category');
    if (cat) payload.category = cat;
    const setStatus = (cls, text) => {
      if (status) {
        status.className = 'aj-form-status ' + cls;
        status.textContent = text;
      }
    };
    setStatus('', '> sending…');
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(async (r) => {
        const data = await r.json().catch(() => ({}));
        if (r.ok) {
          setStatus('ok', '✓ ' + (form.getAttribute('data-aj-success') || data.message || 'Done.'));
          form.reset();
        } else {
          setStatus('err', '✗ ' + (data.message || 'Something went wrong.'));
        }
      })
      .catch(() => setStatus('err', '✗ Network error — please try again.'));
  }
  document.addEventListener('submit', handleDevFormSubmit, true);

  // Render the current route as a file path in the fixed path bar.
  function updateDevPath() {
    const target = document.querySelector('[data-dmj-path]');
    if (!target) {
      return;
    }
    const parts = window.location.pathname.split('/').filter(Boolean);
    target.textContent = parts.length ? parts.join(' / ') : 'index';
  }

  // Mark the active route in the left tmux nav (parent route matches sub-pages).
  function highlightDevNav() {
    const here = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.dmj-nav-item').forEach((item) => {
      const route = (item.getAttribute('data-route') || '').replace(/\/$/, '') || '/';
      const active = route === '/' ? here === '/' : here === route || here.startsWith(route + '/');
      item.classList.toggle('active', active);
    });
  }

  // Typewriter: type out any [data-text] element (respects reduced motion).
  function runTypewriters() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.aj-type[data-text]').forEach((el) => {
      if (el.dataset.typed === '1') {
        return;
      }
      el.dataset.typed = '1';
      const text = el.getAttribute('data-text') || '';
      if (reduce) {
        el.textContent = text;
        el.classList.add('aj-type--done');
        return;
      }
      el.textContent = '';
      let i = 0;
      const tick = () => {
        el.textContent = text.slice(0, i);
        i += 1;
        if (i <= text.length) {
          setTimeout(tick, 24);
        } else {
          el.classList.add('aj-type--done');
        }
      };
      setTimeout(tick, 450);
    });
  }

  const initDevMode = function () {
    // Dev Mode is the default view; only an explicit 'false' opts out.
    applyDevMode(localStorage.devMode !== 'false');
  };

  const initTheme = function () {
    if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
      applyTheme(defaultTheme.replace(':only', ''));
    } else if (
      localStorage.theme === 'dark' ||
      (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      applyTheme('dark');
    } else {
      applyTheme('light');
    }
  };
  initTheme();
  initDevMode();

  function attachEvent(selector, event, fn) {
    const matches = typeof selector === 'string' ? document.querySelectorAll(selector) : selector;
    if (matches && matches.length) {
      matches.forEach((elem) => {
        elem.addEventListener(event, (e) => fn(e, elem), false);
      });
    }
  }

  const onLoad = function () {
    animateHeroGrid();
    toggleAnimationOnView();
    let lastKnownScrollPosition = window.scrollY;
    let ticking = true;

    const searchBlog = document.getElementById('search-blog');
    if (searchBlog) {
      searchBlog.addEventListener('keyup', () => {
        const searchValue = searchBlog.value.toLowerCase();
        const url = new URL(window.location.href);
        if (searchValue === '') {
          url.searchParams.delete('q');
        } else {
          url.searchParams.set('q', searchValue);
        }
        window.history.replaceState({}, '', url);
        //toggle visibility of #server-posts
        const serverPosts = document.getElementById('server-posts');
        if (serverPosts) {
          serverPosts.classList.toggle('hidden', searchValue !== '');
        }

        const pagination = document.getElementById('pagination');
        if (pagination) {
          pagination.classList.toggle('hidden', searchValue !== '');
        }

        const clientPosts = document.getElementById('client-posts');
        if (clientPosts) {
          clientPosts.classList.toggle('hidden', searchValue === '');
        }
      });
    }

    attachEvent('#header nav', 'click', function () {
      document.querySelector('[data-aw-toggle-menu]')?.classList.remove('expanded');
      document.body.classList.remove('overflow-hidden');
      document.getElementById('header')?.classList.remove('h-screen');
      document.getElementById('header')?.classList.remove('expanded');
      document.getElementById('header')?.classList.remove('bg-page');
      document.querySelector('#header nav')?.classList.add('hidden');
      document.querySelector('#header > div > div:last-child')?.classList.add('hidden');
    });

    attachEvent('[data-aw-toggle-menu]', 'click', function (_, elem) {
      elem.classList.toggle('expanded');
      document.body.classList.toggle('overflow-hidden');
      document.getElementById('header')?.classList.toggle('expanded');
      document.getElementById('header')?.classList.toggle('bg-page');
      document.querySelector('#header nav')?.classList.toggle('hidden');
      document.querySelector('#header > div > div:last-child')?.classList.toggle('hidden');
    });

    attachEvent('[data-aw-toggle-color-scheme]', 'click', function () {
      if (defaultTheme.endsWith(':only')) {
        return;
      }
      document.documentElement.classList.toggle('dark');
      localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      toggleCompanyLogo(localStorage.theme);
    });

    attachEvent('[data-aw-toggle-dev-mode]', 'click', function () {
      const enabled = !document.documentElement.classList.contains('dev-mode');
      localStorage.devMode = enabled ? 'true' : 'false';
      applyDevMode(enabled);
    });

    attachEvent('[data-dmj-hamburger]', 'click', function (_, elem) {
      const nav = document.querySelector('[data-dmj-nav]');
      if (!nav) return;
      const open = nav.classList.toggle('open');
      elem.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // Close the mobile nav after following a link (route or in-page section).
    attachEvent('.dmj-nav-item, .dmj-nav-sec', 'click', function () {
      document.querySelector('[data-dmj-nav]')?.classList.remove('open');
    });

    // Copy-link share button.
    attachEvent('[data-aj-copy]', 'click', function (_, elem) {
      const url = elem.getAttribute('data-aj-copy') || window.location.href;
      const label = elem.querySelector('.aj-btn-label');
      const done = () => {
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied ✓';
          setTimeout(() => {
            label.textContent = prev;
          }, 1600);
        }
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done, done);
      } else {
        done();
      }
    });

    attachEvent('[data-aw-social-share]', 'click', function (_, elem) {
      const network = elem.getAttribute('data-aw-social-share');
      const url = encodeURIComponent(elem.getAttribute('data-aw-url'));
      const text = encodeURIComponent(elem.getAttribute('data-aw-text'));

      let href;
      switch (network) {
        case 'facebook':
          href = `https://www.facebook.com/sharer.php?u=${url}`;
          break;
        case 'twitter':
          href = `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
          break;
        case 'linkedin':
          href = `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`;
          break;
        case 'whatsapp':
          href = `https://wa.me/?text=${text}%20${url}`;
          break;
        case 'mail':
          href = `mailto:?subject=%22${text}%22&body=${text}%20${url}`;
          break;

        default:
          return;
      }

      //attach an input change event
      attachEvent('input', 'change', function (e) {
        console.log(e.target);
        const input = e.target;
        if (input.value) {
          href += `&${input.name}=${encodeURIComponent(input.value)}`;
        }
      });

      const newlink = document.createElement('a');
      newlink.target = '_blank';
      newlink.href = href;
      newlink.click();
    });

    function appyHeaderStylesOnScroll() {
      const header = document.querySelector('#header[data-aw-sticky-header]');
      if (!header) {
        ticking = false;
        return;
      }
      if (lastKnownScrollPosition > 60 && !header.classList.contains('scroll')) {
        header.classList.add('scroll');
      } else if (lastKnownScrollPosition <= 60 && header.classList.contains('scroll')) {
        header.classList.remove('scroll');
      }
      ticking = false;
    }
    appyHeaderStylesOnScroll();

    attachEvent([document], 'scroll', function () {
      lastKnownScrollPosition = window.scrollY;

      if (!ticking) {
        window.requestAnimationFrame(() => {
          appyHeaderStylesOnScroll();
        });
        ticking = true;
      }
    });
  };

  const onPageShow = function () {
    document.documentElement.classList.add('motion-safe:scroll-smooth');
    const elem = document.querySelector('[data-aw-toggle-menu]');
    if (elem) {
      elem.classList.remove('expanded');
    }
    document.body.classList.remove('overflow-hidden');
    document.getElementById('header')?.classList.remove('h-screen');
    document.getElementById('header')?.classList.remove('expanded');
    document.querySelector('#header nav')?.classList.add('hidden');
  };

  window.onload = onLoad;
  window.onpageshow = onPageShow;

  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initDevMode();
    animateHeroGrid();
    onLoad();
    onPageShow();
  });
  })();
</script>
