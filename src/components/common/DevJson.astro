---
/**
 * Wraps an index listing. In normal mode the slotted content renders as usual;
 * when Dev Mode is on (`html.dev-mode`) the listing is replaced by a prettified
 * JSON summary shown in a text-editor style panel. Toggling is CSS-only — see the
 * global rules in `Layout.astro` and the toggle logic in `BasicScripts.astro`.
 */
export interface Props {
  /** Serializable summary of the index data. */
  data: unknown;
  /** File name shown in the editor title bar (without extension). */
  label?: string;
}

const { data, label = 'index' } = Astro.props;
const json = JSON.stringify(data, null, 2);
---

<div class="dev-json-wrapper">
  <div data-dev-normal>
    <slot />
  </div>
  <div data-dev-json class="dev-json-editor" aria-hidden="true">
    <div class="dev-json-titlebar">
      <span class="dev-json-dot dev-json-dot--red"></span>
      <span class="dev-json-dot dev-json-dot--yellow"></span>
      <span class="dev-json-dot dev-json-dot--green"></span>
      <span class="dev-json-filename">{label}.json</span>
    </div>
    <pre class="dev-json-code"><code>{json}</code></pre>
  </div>
</div>
