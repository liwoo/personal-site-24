---
import { Icon } from 'astro-icon/components';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  iconName?: string;
}

const {
  label = 'Toggle Dev Mode (view index pages as JSON)',
  class:
    className = 'text-muted dark:text-gray-400 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6',
  iconName = 'tabler:code',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} aria-pressed="false" data-aw-toggle-dev-mode>
  <Icon name={iconName} class={iconClass} />
</button>
