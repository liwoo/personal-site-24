---
import { Icon } from 'astro-icon/components';
import { headerData } from '~/data/navigation';
/**
 * Dev Mode skin — the styles + fixed chrome for the whole-site "editorial JSON"
 * redesign. In Dev Mode (`html.dev-mode`) every page's normal render
 * (`[data-dev-normal]`) is hidden and its artistic JSON document
 * (`[data-dev-json]`, produced by DevDoc.astro) is shown full-bleed. Styling
 * classes are `.aj-*`; see `artisticJson.ts` for the markup they target.
 */
const navItems = [
  { label: 'home', href: '/' },
  ...headerData.links.map((l) => ({ label: String(l.text).toLowerCase(), href: l.href })),
];
---

<!-- Left tmux-style navigation index (fixed; hamburger toggles it on mobile) -->
<button
  type="button"
  class="dmj-hamburger"
  data-dmj-hamburger
  aria-label="Toggle navigation"
  aria-expanded="false"
>
  <span></span><span></span><span></span>
</button>
<aside class="dmj-nav" data-dmj-nav aria-label="Dev Mode navigation">
  <div class="dmj-nav-brand"><span class="dmj-nav-prompt">~/</span>chienda<span class="dmj-nav-blink">▊</span></div>
  <nav class="dmj-nav-list">
    {
      navItems.map((item, i) => (
        <a class="dmj-nav-item" href={item.href} data-route={item.href}>
          <span class="dmj-nav-idx">{String(i).padStart(2, '0')}</span>
          <span class="dmj-nav-name">~/{item.label}</span>
        </a>
      ))
    }
  </nav>
  <div class="dmj-nav-context" data-dmj-context hidden>
    <div class="dmj-nav-ctx-title">// on this page</div>
    <nav class="dmj-nav-sections" data-dmj-sections></nav>
  </div>
  <div class="dmj-nav-foot">
    <div>dev_mode // tmux</div>
    <div class="dmj-nav-path">~ / <b data-dmj-path>index</b>.json</div>
  </div>
</aside>

<!-- Fixed exit control (the header toggle is hidden in Dev Mode) -->
<button type="button" class="dmj-exit" aria-label="Exit Dev Mode" data-aw-toggle-dev-mode>
  <Icon name="tabler:x" class="w-3.5 h-3.5" /> exit dev
</button>
<div class="dmj-sidebar" aria-hidden="true">
  <div>build_ver: 2.0.26</div>
  <div>render_engine: editorial_json</div>
  <div>status: dev_mode</div>
</div>

<style is:global>
  /* --- Visibility: swap the whole page in/out of Dev Mode --------------- */
  [data-dev-json] {
    display: none;
  }
  html.dev-mode [data-dev-normal] {
    display: none;
  }
  html.dev-mode [data-dev-json] {
    display: block;
  }
  html.dev-mode body {
    background-color: #0a0a0c;
  }

  /* --- Document shell --------------------------------------------------- */
  .aj-doc {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    width: 100%;
    padding: 2rem;
    background: #0a0a0c;
    color: #d1d1d1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Space Mono', monospace;
  }
  @media (min-width: 768px) {
    .aj-doc {
      padding: 5rem;
    }
  }
  @media (min-width: 1024px) {
    html.dev-mode .aj-doc {
      padding-left: 17rem;
    }
  }
  .aj-doc ::selection {
    background: rgba(6, 182, 212, 0.3);
    color: #fff;
  }
  .aj-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    background-image: radial-gradient(#2a2a2a 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .aj-shell {
    position: relative;
    z-index: 10;
    max-width: 64rem;
    margin: 0 auto;
  }

  /* --- Reveal stagger --------------------------------------------------- */
  .aj-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: ajRise 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 0.1s + 0.2s);
  }
  .aj-front.aj-reveal {
    animation-delay: 0.08s;
  }
  @keyframes ajRise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aj-reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* --- Front matter ----------------------------------------------------- */
  .aj-front {
    position: relative;
    margin-bottom: 6rem;
    padding-left: 1rem;
  }
  .aj-front-rule {
    position: absolute;
    left: -0.25rem;
    top: 0;
    bottom: 0;
    width: 4px;
    opacity: 0.5;
    background: linear-gradient(to bottom, #f59e0b, transparent);
  }
  .aj-dashes {
    color: rgba(245, 158, 11, 0.8);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }
  .aj-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 2rem;
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0.5rem 0;
  }
  @media (min-width: 768px) {
    .aj-meta {
      grid-template-columns: 150px 1fr;
    }
  }
  .aj-fkey {
    color: #6b7280;
    font-style: italic;
  }
  .aj-fval {
    color: #fff;
  }
  .aj-fval.strong {
    font-weight: 600;
  }
  .aj-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .aj-chip {
    border: 1px solid rgba(34, 211, 238, 0.25);
    color: #22d3ee;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 10px;
    line-height: 1.6;
  }

  /* --- Root + sections -------------------------------------------------- */
  .aj-body {
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }
  .aj-root-open {
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    opacity: 0.5;
    margin-bottom: 3rem;
  }
  .aj-root-close {
    color: #06b6d4;
    font-size: 2.25rem;
    font-weight: 300;
    opacity: 0.3;
    margin-top: 8rem;
  }
  .aj-section {
    position: relative;
  }
  .aj-watermark {
    position: absolute;
    top: -3rem;
    left: -1.5rem;
    pointer-events: none;
    z-index: 0;
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #16161a;
    transition: color 0.3s ease;
    white-space: nowrap;
  }
  .aj-section:hover .aj-watermark {
    color: rgba(6, 182, 212, 0.05);
  }
  .aj-brace {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
  }
  .aj-indent {
    position: relative;
    z-index: 1;
    margin-left: 2rem;
  }
  @media (min-width: 768px) {
    .aj-indent {
      margin-left: 4rem;
    }
  }
  .aj-key-display {
    display: block;
    font-size: clamp(1.6rem, 8vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    color: #fff;
    opacity: 0.92;
    text-transform: uppercase;
    margin: 1rem 0;
    line-height: 1;
  }
  .aj-colon {
    color: #374151;
  }
  .aj-fields {
    margin-left: 1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    padding-left: 2rem;
  }
  .aj-field {
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    color: #9ca3af;
    line-height: 1.6;
    max-width: 38rem;
    margin: 0 0 1rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  /* Long string values wrap within their quotes to save width (esp. mobile). */
  .aj-str,
  .aj-link,
  .aj-val,
  .aj-item-title,
  .aj-key-display,
  .aj-exp-key {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .aj-field .aj-k {
    color: #fcd34d;
  }
  .aj-field--chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .aj-subfields {
    margin-left: 1.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    padding-left: 1.25rem;
  }
  .aj-str {
    color: #fff;
  }
  .aj-num {
    color: #22d3ee;
  }
  .aj-bool {
    color: #f59e0b;
  }
  .aj-null {
    color: #f87171;
  }
  .aj-punc {
    color: #06b6d4;
  }
  .aj-link {
    color: #22d3ee;
    text-decoration: none;
  }
  .aj-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Array sections + items ------------------------------------------ */
  .aj-exp-head {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }
  .aj-exp-key {
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    font-weight: 900;
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    letter-spacing: -0.05em;
    margin-right: 0.5rem;
  }
  .aj-bracket {
    color: #06b6d4;
  }
  .aj-array {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-top: 1rem;
    border-left: 1px solid rgba(6, 182, 212, 0.12);
  }
  .aj-exp-close {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    margin-top: 2rem;
  }
  .aj-item {
    position: relative;
    padding-left: 3rem;
  }
  .aj-item-tick {
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: 2rem;
    height: 1px;
    background: rgba(6, 182, 212, 0.3);
  }
  .aj-brace-sm {
    color: #6b7280;
    font-size: 1.125rem;
  }
  .aj-item-body {
    margin: 0.1rem 0;
  }
  .aj-item-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0.15rem 0 0.4rem;
    transition: color 0.2s ease;
  }
  .aj-item:hover .aj-item-title {
    color: #22d3ee;
  }
  .aj-line {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.75;
    max-width: 40rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .aj-line .aj-lk {
    color: #9ca3af;
    font-style: italic;
  }
  .aj-item--scalar {
    padding-left: 3rem;
    color: #fff;
    font-size: 1.05rem;
  }

  /* --- Creative image rendering (inside the JSON doc) ------------------- */
  .aj-figure {
    display: inline-block;
    position: relative;
    line-height: 0;
    width: fit-content;
    max-width: min(100%, 24rem);
    margin: 0.4rem 0;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #0d0d10;
    vertical-align: middle;
  }
  .aj-figure img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.5) contrast(1.05);
    transition: filter 0.35s ease;
  }
  .aj-figure:hover img {
    filter: none;
  }
  .aj-figure::after {
    content: 'img';
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    padding: 1px 6px;
    font: 9px/1.4 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0a0a0c;
    background: #f59e0b;
    border-bottom-left-radius: 0.4rem;
  }
  .aj-img-cap {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    max-width: 100%;
    box-sizing: border-box;
    padding: 2px 6px;
    font: 10px/1.4 ui-monospace, SFMono-Regular, monospace;
    color: #22d3ee;
    background: rgba(0, 0, 0, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-top-right-radius: 0.4rem;
  }

  /* --- Blink (shared by carets + nav cursor) --------------------------- */
  @keyframes ajBlink {
    50% {
      opacity: 0;
    }
  }

  /* --- Left tmux navigation sidebar ------------------------------------ */
  .dmj-nav,
  .dmj-hamburger {
    display: none;
  }
  html.dev-mode .dmj-nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 14rem;
    z-index: 9997;
    padding: 1.5rem 1rem;
    background: #08080a;
    border-right: 1px solid rgba(34, 211, 238, 0.15);
    font: 12px/1.5 ui-monospace, SFMono-Regular, monospace;
    transform: translateX(0);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }
  html.dev-mode .dmj-nav-brand {
    color: #e5e7eb;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .dmj-nav-prompt {
    color: #f59e0b;
  }
  .dmj-nav-blink {
    color: #22d3ee;
    animation: ajBlink 1s step-end infinite;
  }
  .dmj-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dmj-nav-item {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.35rem 0.5rem;
    border-radius: 0.3rem;
    color: #6b7280;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .dmj-nav-item:hover {
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.03);
  }
  .dmj-nav-idx {
    color: #374151;
    font-size: 10px;
  }
  .dmj-nav-item.active {
    color: #22d3ee;
    background: rgba(6, 182, 212, 0.08);
  }
  .dmj-nav-item.active .dmj-nav-idx {
    color: #22d3ee;
  }
  /* Contextual (in-page) section index — a tmux-like pane list */
  .dmj-nav-context {
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
  }
  .dmj-nav-ctx-title {
    color: #4b5563;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .dmj-nav-sections {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .dmj-nav-sec {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.2rem 0.5rem;
    border-left: 2px solid transparent;
    color: #6b7280;
    text-decoration: none;
    font-size: 11px;
  }
  .dmj-nav-sec:hover {
    color: #e5e7eb;
  }
  .dmj-nav-sec-idx {
    color: #374151;
    font-size: 9px;
  }
  .dmj-nav-sec.active {
    color: #f59e0b;
    border-left-color: #f59e0b;
    background: rgba(245, 158, 11, 0.06);
  }
  .dmj-nav-sec.active .dmj-nav-sec-idx {
    color: #f59e0b;
  }
  .dmj-nav-foot {
    margin-top: auto;
    color: #4b5563;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .dmj-nav-path {
    text-transform: lowercase;
    margin-top: 0.4rem;
  }
  .dmj-nav-path b {
    color: #22d3ee;
    font-weight: 400;
  }
  @media (max-width: 1023px) {
    html.dev-mode .dmj-nav {
      transform: translateX(-100%);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
    }
    html.dev-mode .dmj-nav.open {
      transform: translateX(0);
    }
    html.dev-mode .dmj-hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 9999;
      width: 2.4rem;
      height: 2.4rem;
      padding: 0.55rem;
      background: #0a0a0c;
      border: 1px solid rgba(34, 211, 238, 0.3);
      border-radius: 0.4rem;
      cursor: pointer;
    }
    html.dev-mode .dmj-hamburger span {
      display: block;
      height: 2px;
      background: #22d3ee;
    }
  }

  /* --- Terminal inputs ------------------------------------------------- */
  .aj-input {
    display: block;
    margin: 0 0 1.1rem;
  }
  .aj-input-label {
    display: block;
    color: #9ca3af;
    font-size: 0.8rem;
    font-style: italic;
    margin-bottom: 0.35rem;
  }
  .aj-input-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 34rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.02);
  }
  .aj-input-line:focus-within {
    border-color: #22d3ee;
    box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.12);
  }
  .aj-prompt {
    color: #f59e0b;
    font-weight: 700;
  }
  .aj-input input,
  .aj-input textarea {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: inherit;
    font-size: 0.95rem;
    resize: vertical;
  }
  .aj-input input::placeholder,
  .aj-input textarea::placeholder {
    color: #4b5563;
  }
  .aj-caret {
    flex: none;
    width: 0.5rem;
    height: 1.1rem;
    background: #22d3ee;
    animation: ajBlink 1s step-end infinite;
  }
  .aj-input-line:focus-within .aj-caret {
    display: none;
  }

  /* --- Terminal buttons [[ ... ]] -------------------------------------- */
  .aj-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(34, 211, 238, 0.4);
    border-radius: 0.4rem;
    background: rgba(6, 182, 212, 0.06);
    color: #22d3ee;
    font-family: inherit;
    font-size: 0.8rem;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .aj-btn:hover {
    background: #22d3ee;
    color: #0a0a0c;
  }
  .aj-btn-br {
    color: #f59e0b;
    font-weight: 700;
  }
  .aj-btn:hover .aj-btn-br {
    color: #0a0a0c;
  }
  .aj-btn-label {
    letter-spacing: 0.25em;
  }

  /* --- Beautified terminal cards (footer, forms, CTAs) ----------------- */
  .aj-card {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }
  @media (min-width: 768px) {
    .aj-card {
      padding: 2.5rem 3rem;
    }
  }
  .aj-card-wm {
    position: absolute;
    right: -0.5rem;
    bottom: -2.5rem;
    pointer-events: none;
    font-size: clamp(4rem, 14vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.02);
  }
  .aj-eyebrow {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: #f59e0b;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.72rem;
    text-decoration: underline;
    text-decoration-color: rgba(245, 158, 11, 0.3);
    text-underline-offset: 8px;
  }
  .aj-card-body {
    position: relative;
    z-index: 1;
  }

  /* --- Creative logo wall ---------------------------------------------- */
  .aj-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .aj-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .aj-logo img {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    padding: 0.4rem;
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 0.5rem;
    background: #0d0d10;
    filter: grayscale(1) brightness(1.4);
    transition: filter 0.3s ease;
  }
  .aj-logo:hover img {
    filter: none;
  }
  .aj-logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 0.5rem;
    background: #0d0d10;
    color: #22d3ee;
    font-weight: 700;
    font-size: 1rem;
  }
  .aj-logo-cap {
    color: #6b7280;
    font-size: 10px;
  }

  /* --- Typewriter ------------------------------------------------------ */
  .aj-type {
    border-right: 0.1em solid #22d3ee;
    animation: ajBlink 1s step-end infinite;
  }
  .aj-type.aj-type--done {
    border-right-color: transparent;
    animation: none;
  }

  /* --- Prose (bios, article body) -------------------------------------- */
  .aj-prose {
    max-width: 44rem;
  }
  .aj-p {
    position: relative;
    margin: 0 0 1.1rem;
    padding-left: 1.5rem;
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.75;
  }
  .aj-p-mark {
    position: absolute;
    left: 0;
    color: rgba(34, 211, 238, 0.5);
  }

