---
import { Icon } from 'astro-icon/components';
/**
 * Dev Mode skin — the styles + fixed chrome for the whole-site "editorial JSON"
 * redesign. In Dev Mode (`html.dev-mode`) every page's normal render
 * (`[data-dev-normal]`) is hidden and its artistic JSON document
 * (`[data-dev-json]`, produced by DevDoc.astro) is shown full-bleed. Styling
 * classes are `.aj-*`; see `artisticJson.ts` for the markup they target.
 */
---

<!-- Fixed exit control (the header toggle is hidden in Dev Mode) -->
<button type="button" class="dmj-exit" aria-label="Exit Dev Mode" data-aw-toggle-dev-mode>
  <Icon name="tabler:x" class="w-3.5 h-3.5" /> exit dev
</button>
<div class="dmj-pathbar" aria-hidden="true">~ / <b data-dmj-path>index</b>.json</div>
<div class="dmj-sidebar" aria-hidden="true">
  <div>build_ver: 2.0.26</div>
  <div>render_engine: editorial_json</div>
  <div>status: dev_mode</div>
</div>

<style is:global>
  /* --- Visibility: swap the whole page in/out of Dev Mode --------------- */
  [data-dev-json] {
    display: none;
  }
  html.dev-mode [data-dev-normal] {
    display: none;
  }
  html.dev-mode [data-dev-json] {
    display: block;
  }
  html.dev-mode body {
    background-color: #0a0a0c;
  }

  /* --- Document shell --------------------------------------------------- */
  .aj-doc {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    width: 100%;
    padding: 2rem;
    background: #0a0a0c;
    color: #d1d1d1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Space Mono', monospace;
  }
  @media (min-width: 768px) {
    .aj-doc {
      padding: 5rem;
    }
  }
  .aj-doc ::selection {
    background: rgba(6, 182, 212, 0.3);
    color: #fff;
  }
  .aj-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    background-image: radial-gradient(#2a2a2a 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .aj-shell {
    position: relative;
    z-index: 10;
    max-width: 64rem;
    margin: 0 auto;
  }

  /* --- Reveal stagger --------------------------------------------------- */
  .aj-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: ajRise 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i, 0) * 0.1s + 0.2s);
  }
  .aj-front.aj-reveal {
    animation-delay: 0.08s;
  }
  @keyframes ajRise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aj-reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* --- Front matter ----------------------------------------------------- */
  .aj-front {
    position: relative;
    margin-bottom: 6rem;
    padding-left: 1rem;
  }
  .aj-front-rule {
    position: absolute;
    left: -0.25rem;
    top: 0;
    bottom: 0;
    width: 4px;
    opacity: 0.5;
    background: linear-gradient(to bottom, #f59e0b, transparent);
  }
  .aj-dashes {
    color: rgba(245, 158, 11, 0.8);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }
  .aj-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 2rem;
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0.5rem 0;
  }
  @media (min-width: 768px) {
    .aj-meta {
      grid-template-columns: 150px 1fr;
    }
  }
  .aj-fkey {
    color: #6b7280;
    font-style: italic;
  }
  .aj-fval {
    color: #fff;
  }
  .aj-fval.strong {
    font-weight: 600;
  }
  .aj-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .aj-chip {
    border: 1px solid rgba(34, 211, 238, 0.25);
    color: #22d3ee;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 10px;
    line-height: 1.6;
  }

  /* --- Root + sections -------------------------------------------------- */
  .aj-body {
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }
  .aj-root-open {
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    opacity: 0.5;
    margin-bottom: 3rem;
  }
  .aj-root-close {
    color: #06b6d4;
    font-size: 2.25rem;
    font-weight: 300;
    opacity: 0.3;
    margin-top: 8rem;
  }
  .aj-section {
    position: relative;
  }
  .aj-watermark {
    position: absolute;
    top: -3rem;
    left: -1.5rem;
    pointer-events: none;
    z-index: 0;
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #16161a;
    transition: color 0.3s ease;
    white-space: nowrap;
  }
  .aj-section:hover .aj-watermark {
    color: rgba(6, 182, 212, 0.05);
  }
  .aj-brace {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
  }
  .aj-indent {
    position: relative;
    z-index: 1;
    margin-left: 2rem;
  }
  @media (min-width: 768px) {
    .aj-indent {
      margin-left: 4rem;
    }
  }
  .aj-key-display {
    display: block;
    font-size: clamp(2rem, 8vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    color: #fff;
    opacity: 0.92;
    text-transform: uppercase;
    margin: 1rem 0;
    line-height: 1;
  }
  .aj-colon {
    color: #374151;
  }
  .aj-fields {
    margin-left: 1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    padding-left: 2rem;
  }
  .aj-field {
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    color: #9ca3af;
    line-height: 1.6;
    max-width: 46rem;
    margin: 0 0 1rem;
    word-break: break-word;
  }
  .aj-field .aj-k {
    color: #fcd34d;
  }
  .aj-field--chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .aj-subfields {
    margin-left: 1.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    padding-left: 1.25rem;
  }
  .aj-str {
    color: #fff;
  }
  .aj-num {
    color: #22d3ee;
  }
  .aj-bool {
    color: #f59e0b;
  }
  .aj-null {
    color: #f87171;
  }
  .aj-punc {
    color: #06b6d4;
  }
  .aj-link {
    color: #22d3ee;
    text-decoration: none;
  }
  .aj-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Array sections + items ------------------------------------------ */
  .aj-exp-head {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }
  .aj-exp-key {
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    font-weight: 900;
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    letter-spacing: -0.05em;
    margin-right: 0.5rem;
  }
  .aj-bracket {
    color: #06b6d4;
  }
  .aj-array {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-top: 1rem;
    border-left: 1px solid rgba(6, 182, 212, 0.12);
  }
  .aj-exp-close {
    position: relative;
    z-index: 1;
    color: #06b6d4;
    font-size: 1.5rem;
    font-weight: 300;
    margin-top: 2rem;
  }
  .aj-item {
    position: relative;
    padding-left: 3rem;
  }
  .aj-item-tick {
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: 2rem;
    height: 1px;
    background: rgba(6, 182, 212, 0.3);
  }
  .aj-brace-sm {
    color: #6b7280;
    font-size: 1.125rem;
  }
  .aj-item-body {
    margin: 0.1rem 0;
  }
  .aj-item-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0.15rem 0 0.4rem;
    transition: color 0.2s ease;
  }
  .aj-item:hover .aj-item-title {
    color: #22d3ee;
  }
  .aj-line {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .aj-line .aj-lk {
    color: #9ca3af;
    font-style: italic;
  }
  .aj-item--scalar {
    padding-left: 3rem;
    color: #fff;
    font-size: 1.05rem;
  }

  /* --- Creative image rendering (inside the JSON doc) ------------------- */
  .aj-figure {
    display: inline-block;
    position: relative;
    line-height: 0;
    width: fit-content;
    max-width: min(100%, 24rem);
    margin: 0.4rem 0;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #0d0d10;
    vertical-align: middle;
  }
  .aj-figure img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.5) contrast(1.05);
    transition: filter 0.35s ease;
  }
  .aj-figure:hover img {
    filter: none;
  }
  .aj-figure::after {
    content: 'img';
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    padding: 1px 6px;
    font: 9px/1.4 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0a0a0c;
    background: #f59e0b;
    border-bottom-left-radius: 0.4rem;
  }
  .aj-img-cap {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    max-width: 100%;
    box-sizing: border-box;
    padding: 2px 6px;
    font: 10px/1.4 ui-monospace, SFMono-Regular, monospace;
    color: #22d3ee;
    background: rgba(0, 0, 0, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-top-right-radius: 0.4rem;
  }

  /* --- Fixed chrome ----------------------------------------------------- */
  .dmj-exit,
  .dmj-pathbar,
  .dmj-sidebar {
    display: none;
  }
  html.dev-mode .dmj-exit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10000;
    padding: 0.4rem 0.7rem;
    font: 11px/1 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0a0a0c;
    background: #22d3ee;
    border: none;
    border-radius: 0.4rem;
    cursor: pointer;
  }
  html.dev-mode .dmj-exit:hover {
    background: #67e8f9;
  }
  html.dev-mode .dmj-pathbar {
    display: block;
    position: fixed;
    left: 1rem;
    bottom: 1.1rem;
    z-index: 9998;
    pointer-events: none;
    font: 10px/1.5 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: #4b5563;
  }
  html.dev-mode .dmj-pathbar b {
    color: #22d3ee;
    font-weight: 400;
  }
  html.dev-mode .dmj-sidebar {
    display: block;
    position: fixed;
    right: 1.25rem;
    bottom: 1.1rem;
    z-index: 9998;
    pointer-events: none;
    font: 10px/1.6 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: #4b5563;
  }
</style>
