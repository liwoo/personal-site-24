---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import BlogFilters from '~/components/blog/BlogFilters.astro';
import BlogPostList from '~/components/blog/BlogPostList.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { NewsletterInline } from '~/components/widgets/NewsletterInline';
import { blogListRobots, getStaticPathsBlogList, fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { summarizePost } from '~/utils/devMode';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;

const currentPage = page.currentPage || 1;

const metadata = {
  title: `AI Agent Engineering Blog${currentPage > 1 ? `: page ${currentPage}` : ''}`,
  description:
    'Deep dives on AI agent architecture, memory systems, tool calling, MCP, token economics, generative UI, and production safety patterns.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};

const allPosts = await fetchPosts();
const allCategories = [...new Set(allPosts.map((p) => p.category).filter(Boolean))] as string[];
const totalMinutes = allPosts.reduce((sum, p) => sum + (p.readingTime ?? 0), 0);
const tagCounts: Record<string, number> = {};
allPosts.forEach((p) => (p.tags ?? []).forEach((t) => (tagCounts[t] = (tagCounts[t] ?? 0) + 1)));
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24)
  .map(([t]) => t);

const dev = {
  front: [
    { key: 'total_articles', value: String(allPosts.length), strong: true },
    { key: 'categories', value: String(allCategories.length) },
    { key: 'reading_minutes', value: String(totalMinutes) },
  ],
  data: {
    index: 'blog',
    count: allPosts.length,
    pagination: { currentPage, lastPage: page.lastPage, total: page.total },
    // Live, debounced client-side filter over the full list below (no button).
    filter: { __type: 'search', placeholder: 'search all articles…' },
    categories: {
      __type: 'linkchips',
      items: allCategories.map((c) => ({ label: c, href: getPermalink(c, 'category') })),
    },
    posts: allPosts.map(summarizePost),
    subscribe: {
      __type: 'form',
      endpoint: '/api/newsletter',
      category: 'tech',
      submit: 'Subscribe',
      success: 'subscribed, new deep dives in your inbox',
      fields: [
        { name: 'name', label: '"name"', placeholder: 'Your name', type: 'text' },
        { name: 'email', label: '"email"', placeholder: 'you@domain.com', type: 'email', required: true },
      ],
    },
    // Tag cloud at the very bottom.
    tags: {
      __type: 'linkchips',
      items: topTags.map((t) => ({ label: t, href: getPermalink(t, 'tag') })),
    },
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="writing"
    title="AI agent engineering, in practice"
    subtitle="Notes from shipping agents, RAG and LLM products to production."
    width="container-lg"
  >
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs tabular-nums">
      <li class="glass px-3 py-1">{allPosts.length} articles</li>
      <li class="glass px-3 py-1">{Math.round(totalMinutes / 60)} hrs of reading</li>
    </ul>
  </PageHeader>

  <section class="container-lg pb-12 lg:pb-16" aria-label="Articles">
    <BlogFilters active="all" search currentPage={currentPage} />
    <div id="blog-results">
      <BlogPostList posts={page.data} />
      <Pagination
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        currentPage={currentPage}
        lastPage={page.lastPage}
      />
    </div>
  </section>

  <div class="container-lg pb-16 lg:pb-24">
    <NewsletterInline client:visible />
  </div>
</Layout>
