---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { mdToRichHtml } from '~/utils/richMarkdown';

// Resolve imported post images (e.g. `<Image src={foo}/>`) to real URLs so Dev
// Mode can render them — maps the MDX `import foo from '~/assets/...'` to the
// built asset URL, then inlines `src={foo}` as `src="<url>"`.
const ASSETS = import.meta.glob<{ default: { src: string } }>(
  '/src/assets/**/*.{png,jpg,jpeg,webp,gif,svg,avif}',
  { eager: true }
);
const resolveContentImages = (md: string | undefined): string | undefined => {
  if (!md) return md;
  const vars: Record<string, string> = {};
  const importRe = /^import\s+(\w+)\s+from\s+['"]([^'"]+)['"]/gm;
  let m: RegExpExecArray | null;
  while ((m = importRe.exec(md))) {
    const key = m[2].replace(/^~\//, '/src/');
    const asset = ASSETS[key];
    if (asset) vars[m[1]] = asset.default.src;
  }
  return md.replace(/src=\{(\w+)\}/g, (full, v) => (vars[v] ? `src="${vars[v]}"` : full));
};
import { getStaticPathsBlogPost, blogPostRobots, getPostsFromTags } from '~/utils/blog';
import { categoryLink, tagLinks } from '~/utils/devMode';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';
import Hero2 from '~/components/widgets/Hero2.astro';

import { getFormattedDate } from '~/utils/utils';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

const coverSrc = typeof image === 'string' ? image : (image as ImageMetadata | undefined)?.src;

// Related articles that share tags with this one (excluding itself).
const relatedPosts = (await getPostsFromTags(post.tags ?? []))
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3)
  .map((p) => ({
    title: p.title,
    permalink: getPermalink(p.permalink, 'post'),
    category: categoryLink(p.category),
    readingTime: p.readingTime ? `${p.readingTime} min` : null,
  }));

const dev = {
  front: [
    { key: 'title', value: JSON.stringify(post.title) },
    { key: 'published', value: JSON.stringify(post.publishDate instanceof Date ? post.publishDate.toISOString().slice(0, 10) : String(post.publishDate)) },
    { key: 'reading_time', value: `"${post.readingTime ?? '?'} min"`, strong: true },
  ],
  chips: { key: 'tags', items: post.tags ?? [] },
  data: {
    post: {
      title: post.title,
      slug: post.slug,
      permalink: getPermalink(post.permalink, 'post'),
      publishDate: post.publishDate instanceof Date ? post.publishDate.toISOString().slice(0, 10) : post.publishDate,
      category: categoryLink(post.category),
      tags: tagLinks(post.tags),
      readingTime: post.readingTime ?? null,
      cover: coverSrc ?? null,
      excerpt: post.excerpt ?? null,
    },
    article: { __type: 'richtext', html: mdToRichHtml(resolveContentImages(post.content)) },
    ...(relatedPosts.length ? { related: relatedPosts } : {}),
    share: { __type: 'share', url, text: post.title },
    subscribe: {
      __type: 'form',
      endpoint: '/api/newsletter',
      category: post.category ?? 'general',
      submit: 'Subscribe',
      success: 'subscribed — new deep dives land in your inbox',
      fields: [
        { name: 'name', label: '"name"', placeholder: 'Your name', type: 'text' },
        { name: 'email', label: '"email"', placeholder: 'you@domain.com', type: 'email', required: true },
      ],
    },
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <Hero2>
    <Fragment slot="title">
      <div class="z-10 relative">
        <ToBlogLink />
      </div>
      {post.title}
    </Fragment>

    <Fragment slot="subtitle" class="relative z-10">{post.excerpt}</Fragment>
    <Fragment slot="content">
      <div class="flex justify-between flex-col sm:flex-row mt-0 mb-2 text-secondary z-10 relative">
        <p>
          {'⏰ '}
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="capitalize hover:underline inline-block" href={getPermalink(post.category, 'category')}>
                  {post.category.replaceAll('-', ' ')}
                </a>
              </>
            )
          }
          {post.readingTime && <> · {post.readingTime} min read</>}
        </p>
      </div>
    </Fragment>
  </Hero2>
  <div class="relative">
    <SinglePost post={{ ...post, image: image }} url={url} />
  </div>
</Layout>
