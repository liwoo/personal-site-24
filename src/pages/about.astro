---
import { Bio } from '~/components/widgets/Bio.tsx';
import { AboutTabs } from '~/components/widgets/AboutTabs.tsx';
import { ProfileSidebar } from '~/components/widgets/ProfileSidebar.tsx';
import Hero2 from '~/components/widgets/Hero2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { workExperience } from '~/data/work-experience';
import { techStack } from '~/data/stack';

export const prerender = true;

const metadata = {
  title: 'About Jeremiah Chienda — Governance-Grade AI Engineer | National-Scale AI',
  description:
    'AI engineer building trustworthy AI for high-stakes, regulated environments. Ten years shipping production systems across Malawi, Rwanda, Japan and the UK — from national health platforms to a govtech assistant serving 12M citizens, now inside a UK data regulator.',
};

const dev = {
  front: [
    { key: 'status', value: '"Trustworthy AI for high-stakes, regulated environments"', strong: true },
    { key: 'current', value: '"AI Engineer @ ICO — the UK data regulator"' },
    { key: 'based', value: '["Manchester, UK"]' },
  ],
  chips: { key: 'focus', items: ['Responsible AI', 'RAG', 'Agents', 'AI Governance', 'LLM Apps'] },
  data: {
    profile: {
      name: 'Jeremiah Chienda',
      headline: 'Governance-grade AI engineer',
      mission: 'I build trustworthy AI for high-stakes, regulated environments — the kind where being wrong has consequences.',
    },
    experience: workExperience.map((w) => ({
      company: w.title,
      role: w.position,
      location: w.location,
      duration: w.duration,
      impact: Array.isArray(w.description) ? w.description[0] : w.description,
    })),
    skills: techStack
      .slice()
      .sort((a, b) => b.experience - a.experience)
      .slice(0, 10)
      .map((s) => s.title),
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <Hero2 tagline="Trustworthy AI for the places tech forgets">
    <Fragment slot="title"><span class="underlined">About</span> Me</Fragment>

    <Fragment slot="subtitle">
      I build trustworthy AI for high-stakes, regulated environments — the kind where being wrong has consequences.
    </Fragment>
    <Fragment slot="content">
      <a href="https://getalinafe.com">&gt;&gt; Also a gospel rapper — Liwu</a>
    </Fragment>
  </Hero2>

  <div class="flex flex-col lg:flex-row relative container my-12 gap-x-4 lg:gap-x-12">
    <div class="w-full lg:w-3/5">
      <AboutTabs client:visible />
      <div class="mt-8">
        <Button href="/contact" variant="primary">Want to work together? Get in Touch</Button>
      </div>
    </div>
    <div class="w-full md:w-2/3 md:mx-auto lg:w-2/5 mt-8 lg:mt-0 min-w-0">
      <ProfileSidebar client:visible />
    </div>
  </div>
</Layout>
