---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import { setup } from '~/data/using';

export const prerender = true;

const metadata = {
  title: 'My Setup - Using',
  description: 'The tools and equipment I use daily for development, content creation, and work.',
};

const dev = {
  front: [
    { key: 'title', value: '"My setup"', strong: true },
    { key: 'items', value: String(setup.length) },
  ],
  chips: { key: 'desk', items: setup.map((s) => s.name) },
  data: {
    setup: setup.map((s) => ({ category: s.category, name: s.name, what: s.description, specs: s.specs })),
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader label="using" title="My setup" subtitle="What's on my desk." width="container-lg">
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs tabular-nums">
      <li class="glass px-3 py-1">{setup.length} items</li>
    </ul>
  </PageHeader>

  <section class="container-lg pb-16 lg:pb-24" aria-label="Setup">
    <ul class="glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
      {
        setup.map((item) => (
          <li class="flex items-start gap-4 px-4 sm:px-6 py-4">
            <span
              class="w-10 h-10 shrink-0 rounded border border-gray-500/20 flex items-center justify-center text-primary"
              aria-hidden="true"
            >
              <Icon name={item.icon} class="w-5 h-5" />
            </span>
            <div class="flex-1 min-w-0">
              <h2 class="font-semibold text-default leading-snug">{item.name}</h2>
              <p class="mt-1 sm:hidden text-xs uppercase tracking-widest text-muted">{item.category}</p>
              <p class="mt-0.5 text-sm text-muted leading-snug">{item.description}</p>
              <details class="see-more mt-2">
                <summary>
                  <span class="see-more-label">See</span>
                </summary>
                <ul class="mt-2 space-y-1 text-sm text-muted">
                  {item.specs.map((spec) => (
                    <li>{spec}</li>
                  ))}
                </ul>
              </details>
            </div>
            <span class="hidden sm:block shrink-0 w-32 text-right text-xs uppercase tracking-widest text-muted">
              {item.category}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
