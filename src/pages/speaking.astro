---
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import TalkRow from '~/components/widgets/TalkRow.astro';
import Button from '~/components/ui/Button.astro';
import { talks, communityAndHosting, type Talk } from '~/data/talks';

export const prerender = true;

const metadata = {
  title: 'Speaking | AI Governance, Agents & GovTech Talks',
  description:
    'Talks, panels and workshops by Jeremiah Chienda on AI governance, agentic AI, RAG, LLM quantization and GovTech at national scale, across Africa and Europe.',
};

const typeLabel: Record<Talk['type'], string> = {
  talk: 'Talk',
  panel: 'Panel',
  webinar: 'Webinar',
  workshop: 'Workshop',
};

/** "2026-10-14" -> "14 Oct 2026", "2024" -> "2024", null -> null. */
const formatDate = (date: string | null): string | null => {
  if (!date) return null;
  if (/^\d{4}$/.test(date)) return date;
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};

// A talk marked upcoming whose date has passed (as of the build) is listed with
// the past talks, so the page never advertises an event that already happened.
const today = new Date().toISOString().slice(0, 10);
const isUpcoming = (t: Talk) => t.status === 'upcoming' && (!t.date || t.date.length < 10 || t.date >= today);

const upcoming = talks.filter(isUpcoming);
const featured = talks.filter((t) => !isUpcoming(t) && t.featured);
const earlier = talks.filter((t) => !isUpcoming(t) && !t.featured);

const countries = new Set(
  [...talks, ...communityAndHosting]
    .map((t) => (t.location.split(',').pop() ?? '').replace(/\(.*?\)/g, '').trim())
    .filter((c) => c && !/^online/i.test(c))
);

const talkLinks = (t: Talk) =>
  [
    t.recordingUrl && { label: 'Watch', href: t.recordingUrl },
    t.slidesUrl && { label: 'Slides', href: t.slidesUrl },
    t.eventUrl && t.eventUrl !== t.recordingUrl && { label: 'Event', href: t.eventUrl },
  ].filter(Boolean) as Array<{ label: string; href: string }>;

const talkRow = (t: Talk) => ({
  title: t.title,
  meta: `${t.event} · ${t.location}`,
  side: [typeLabel[t.type], formatDate(t.date)],
  description: t.description,
  note: t.affiliation ? `${t.role}, ${t.affiliation}` : t.role,
  topics: t.topics,
  links: talkLinks(t),
});

const talkItem = (t: Talk) => ({
  title: t.title,
  event: t.event,
  type: t.type,
  date: t.date,
  location: t.location,
  role: t.role,
  affiliation: t.affiliation,
  abstract: t.description,
  topics: t.topics,
  event_url: t.eventUrl ? { __type: 'cta', label: 'Event', href: t.eventUrl } : null,
  recording: t.recordingUrl ? { __type: 'cta', label: 'Watch', href: t.recordingUrl } : null,
  slides: t.slidesUrl ? { __type: 'cta', label: 'Slides', href: t.slidesUrl } : null,
});

const dev = {
  front: [
    { key: 'status', value: '"Available for talks, panels & workshops"', strong: true },
    { key: 'talks', value: String(talks.length) },
    { key: 'countries', value: JSON.stringify([...countries]) },
    { key: 'topics', value: '["AI Governance", "Agentic AI", "RAG", "GovTech"]' },
  ],
  data: {
    upcoming: upcoming.map(talkItem),
    talks: featured.map(talkItem),
    earlier: earlier.map(talkItem),
    community: communityAndHosting.map((c) => ({
      title: c.title,
      role: c.role,
      type: c.type,
      location: c.location,
      about: c.description,
      topics: c.topics,
      link: c.eventUrl ? { __type: 'cta', label: 'Visit', href: c.eventUrl } : null,
    })),
    invite: { __type: 'cta', label: "Let's_Talk", href: '/contact' },
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="speaking"
    title="Talks"
    subtitle="AI governance, agents and GovTech at national scale, from Kigali to Manchester."
    width="container-lg"
  >
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs tabular-nums">
      <li class="glass px-3 py-1">{talks.length} talks</li>
      <li class="glass px-3 py-1">{countries.size} countries</li>
      <li class="glass px-3 py-1">{communityAndHosting.length} community roles</li>
    </ul>
    <Fragment slot="actions">
      <Button href="/contact" variant="primary" class="rounded-md">Let's_Talk</Button>
    </Fragment>
  </PageHeader>

  {
    upcoming.length > 0 && (
      <section class="container-lg pb-12 lg:pb-16">
        {upcoming.map((t) => (
          <article class="glass glass-sheen rounded-xl px-4 sm:px-6 py-5 mb-4 last:mb-0">
            <p class="terminal-label">upcoming</p>
            <h2 class="mt-2 text-xl md:text-2xl font-bold tracking-tight text-heading">{t.title}</h2>
            <p class="mt-1 text-sm text-muted">
              {typeLabel[t.type]} · {t.event}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2 text-xs tabular-nums">
              {formatDate(t.date) && <li class="glass px-3 py-1">{formatDate(t.date)}</li>}
              <li class="glass px-3 py-1">{t.location}</li>
            </ul>
            <details class="see-more mt-4">
              <summary>
                <span class="see-more-label">See</span>
              </summary>
              <p class="mt-2 text-sm text-muted leading-relaxed">{t.description}</p>
            </details>
            {(t.slidesUrl || t.eventUrl) && (
              <div class="mt-5 flex flex-wrap items-center gap-4">
                {t.slidesUrl && (
                  <Button href={t.slidesUrl} variant="secondary" class="rounded-md" target="_blank">
                    Slides
                  </Button>
                )}
                {t.eventUrl && (
                  <a href={t.eventUrl} target="_blank" rel="noopener noreferrer" class="btn-link text-xs">
                    Event
                  </a>
                )}
              </div>
            )}
          </article>
        ))}
      </section>
    )
  }

  <section class="container-lg pb-12 lg:pb-16">
    <p class="terminal-label">talks</p>
    <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">AI, agents and GovTech</h2>
    <ul class="mt-6 glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
      {featured.map((t) => <TalkRow {...talkRow(t)} />)}
    </ul>
  </section>

  {
    earlier.length > 0 && (
      <section class="container-lg pb-12 lg:pb-16">
        <p class="terminal-label">earlier</p>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">Web3 and dev community</h2>
        <ul class="mt-6 glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
          {earlier.map((t) => (
            <TalkRow {...talkRow(t)} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="container-lg pb-16 lg:pb-24">
    <p class="terminal-label">community</p>
    <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">Rooms I've run</h2>
    <ul class="mt-6 glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
      {
        communityAndHosting.map((c) => (
          <TalkRow
            title={c.title}
            meta={c.location}
            side={[c.role]}
            description={c.description}
            topics={c.topics}
            links={c.eventUrl ? [{ label: 'Visit', href: c.eventUrl }] : []}
          />
        ))
      }
    </ul>
  </section>
</Layout>
