---
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import HomeArticles from '~/components/widgets/HomeArticles.astro';
import Button from '~/components/ui/Button.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = { title: 'Page not found', robots: { index: false } };

const dev = {
  front: [
    { key: 'status', value: '404', strong: true },
    { key: 'route', value: JSON.stringify(Astro.url.pathname) },
  ],
  data: {
    error: {
      code: 404,
      message: 'That link is broken or the page moved.',
      home: { __type: 'cta', label: 'Go_Home', href: getHomePermalink() },
      articles: { __type: 'cta', label: 'Articles', href: '/blog' },
    },
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader label="404" title="Page not found" subtitle="That link is broken or the page moved." width="container-lg">
    <Fragment slot="actions">
      <Button href={getHomePermalink()} variant="primary" class="rounded-md">Go_Home</Button>
      <Button href="/blog" variant="secondary" class="rounded-md">Articles</Button>
    </Fragment>
  </PageHeader>

  <HomeArticles count={3} />
</Layout>
