---
import Layout from '~/layouts/PageLayout.astro';

import HomeHero from '~/components/widgets/HomeHero.astro';
import HomeAbout from '~/components/widgets/HomeAbout.astro';
import HomeFlagship from '~/components/widgets/HomeFlagship.astro';
import { footerData } from '~/data/navigation';
import HomeArticles from '~/components/widgets/HomeArticles.astro';
import Button from '~/components/ui/Button.astro';
import { findPostsByCategory } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { projects } from '~/data/projects';

export const prerender = true;

const metadata = {
  ignoreTitleTemplate: true,
};

const name: string = 'Liwu';

// Real company logos for the career highlight.
const logoGlob = import.meta.glob<{ default: { src: string } }>('/src/assets/images/logos/png/*-symbol.png', {
  eager: true,
});
const logo = (key: string) => logoGlob[`/src/assets/images/logos/png/${key}-symbol.png`]?.default?.src ?? null;

const iremboProject = projects.find((p) => p.slug === 'irembo-ai');
const iremboCover = typeof iremboProject?.image?.src === 'string' ? iremboProject.image.src : null;

const latestWriting = (await findPostsByCategory('tech')).slice(0, 4).map((p) => ({
  title: p.title,
  permalink: getPermalink(p.permalink, 'post'),
  date: p.publishDate instanceof Date ? p.publishDate.toISOString().slice(0, 10) : String(p.publishDate),
  readingTime: p.readingTime ? `${p.readingTime} min` : null,
}));

// Dev Mode: the artistic-JSON portrait of the home page. Front matter is the
// landing metadata — kept to the highest-signal fields (the role/status detail
// lives in the career highlight below, so it isn't duplicated here).
const dev = {
  banner: 'AI ENGINEER',
  front: [
    { key: 'status', value: '"I built IremboAI, currently serving 12M citizens in Rwanda"', strong: true, href: '/ai-for-12-million-citizens' },
    { key: 'location', value: '["Manchester, UK", "Kigali, RW"]' },
  ],
  chips: { key: 'stack', items: ['Microsoft Fabric', 'Azure AI Foundry', 'MAF', 'LangChain', 'Langfuse'] },
  links: [
    { label: 'LinkedIn (6k+ followers)', href: 'https://linkedin.com/in/jchienda' },
    { label: 'GitHub (150+ followers)', href: 'https://github.com/liwoo' },
    { label: 'X / @liwucodes', href: 'https://x.com/liwucodes' },
    { label: 'YouTube / @liwucodes', href: 'https://www.youtube.com/@liwucodes' },
  ],
  ctas: [{ label: 'Get in touch', href: '/contact' }],
  data: {
    profile: {
      name: 'Jeremiah Chienda',
      portrait: 'https://pub-a0f6f56fff3c42b9bb30bd2143c99754.r2.dev/2026.jpg',
      mission: { __type: 'typewriter', value: 'I build AI agents that go past the demo stage.' },
    },
    irembo_ai: {
      role: 'Led the AI team that built it',
      benchmark: "95% on accuracy & tone, scored against the call center's own answers",
      cover: iremboCover,
      story: { __type: 'link', label: 'How we built it', href: '/ai-for-12-million-citizens' },
    },
    career: [
      { company: 'Irembo', logo: logo('irembo'), role: 'AI Engineering Lead', impact: 'Built IremboAI (12M citizens)' },
      { company: 'ICO', logo: logo('ico'), role: 'AI Engineer', impact: "Responsible Data & AI at the UK's data regulator" },
      { company: 'One Acre Fund', logo: logo('oaf'), role: 'Lead Software Engineer', impact: 'Systems serving 1M+ smallholder farmers' },
    ],
    focus_areas: ['Agent Architecture', 'RAG Pipelines', 'MCP', 'Generative UI', 'AI Safety', 'Token Economics'],
    latest_writing: latestWriting,
    creative_engine: {
      alias: 'Liwu',
      genre: 'Gospel Rap',
      highlights: ['UMP Cypha 2018', 'Machine Minder'],
    },
    newsletter: {
      __type: 'form',
      endpoint: '/api/newsletter',
      category: 'general',
      submit: 'Subscribe',
      success: 'subscribed — check your inbox for confirmation',
      fields: [
        { name: 'name', label: '"name"', placeholder: 'Your name', type: 'text' },
        { name: 'email', label: '"email"', placeholder: 'you@domain.com', type: 'email', required: true },
      ],
    },
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <HomeHero socialLinks={footerData.socialLinks} title="AI Engineer" name="Jeremiah Chienda">
    <Fragment slot="description">
      <span class="hidden md:inline"
        >Hi 👋🏽, I'm Jeremiah. I built <a href="/ai-for-12-million-citizens" class="underlined">IremboAI</a>, the AI
        assistant 12 million Rwandans can ask about their government.</span
      ><span class="md:hidden">I built <a href="/ai-for-12-million-citizens" class="underlined">IremboAI</a>, the AI
        assistant 12M Rwandans can ask about their government.</span>
    </Fragment>
  </HomeHero>
  <HomeFlagship />
  <div class="scroll-fade-in">
    <HomeAbout />
  </div>
  <div class="scroll-fade-in">
    <HomeArticles />
  </div>
  <div class="scroll-fade-in">
    <section class="container py-16 text-center">
      <h2 class="text-2xl font-semibold mb-3">Looking for an AI Engineer?</h2>
      <p class="text-muted max-w-xl mx-auto mb-6">
        I'm open to contract and full-time AI engineering opportunities — agent systems, RAG pipelines, LLM
        applications, and AI product strategy.
      </p>
      <Button href="/contact" variant="primary">Let's Talk</Button>
    </section>
  </div>
</Layout>

<style>
  .scroll-fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }

  .scroll-fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observerCallback = (entries: IntersectionObserverEntry[]) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  };

  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px',
  };

  const observer = new IntersectionObserver(observerCallback, observerOptions);

  // Observe all elements with the scroll-fade-in class
  const animatedElements = document.querySelectorAll('.scroll-fade-in');
  animatedElements.forEach((element) => observer.observe(element));

  // Re-observe on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    const elements = document.querySelectorAll('.scroll-fade-in');
    elements.forEach((element) => observer.observe(element));
  });
</script>
