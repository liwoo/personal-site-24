---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import Layout from '~/layouts/PageLayout.astro';
import { projects } from '~/data/projects';
import { projectYears, splitFirstSentence } from '~/utils/projects';
import type { MetaData, Project } from '~/types';

export const prerender = true;

export const getStaticPaths = (() =>
  projects
    .filter((p) => p.slug)
    .map((p, i, all) => ({
      params: { project: p.slug },
      props: { project: p, next: all[(i + 1) % all.length] },
    }))) satisfies GetStaticPaths;

const { project: p, next } = Astro.props as { project: Project; next: Project };

const cover = typeof p.image?.src === 'string' ? p.image.src : undefined;
const years = projectYears(p.duration);
const showCompany = p.company?.name && p.company.name !== p.title;

// Method copy is meant to be 1 or 2 sentences. If one runs long, show the
// first sentence and tuck the rest behind "See more".
const methods = (p.methods ?? []).map((m) => {
  const [lead, rest] = (m.description ?? '').length > 180 ? splitFirstSentence(m.description) : [m.description, ''];
  return { title: m.title, lead, rest };
});

const testimony = p.testimony?.testimony ? p.testimony : null;
const [quoteLead, quoteRest] = splitFirstSentence(testimony?.testimony);
const avatar = typeof testimony?.image?.src === 'string' ? testimony.image.src : undefined;

const metadata: MetaData = {
  title: p.title,
  description: p.subtitle ?? p.description,
  openGraph: { type: 'article', ...(cover ? { images: [{ url: cover }] } : {}) },
};

const dev = {
  front: [
    { key: 'title', value: JSON.stringify(p.title ?? ''), strong: true },
    { key: 'role', value: JSON.stringify(p.role ?? null) },
    { key: 'years', value: JSON.stringify(years) },
  ],
  chips: { key: 'stack', items: p.stack ?? [] },
  data: {
    project: {
      title: p.title ?? null,
      slug: p.slug ?? null,
      company: p.company?.name ?? null,
      role: p.role ?? null,
      years,
      stack: p.stack ?? [],
      cover: cover ?? null,
      liveUrl: p.projectLink ? { __type: 'cta', label: 'View_Live', href: p.projectLink } : null,
      sourceUrl: p.sourceLink ? { __type: 'cta', label: 'Source', href: p.sourceLink } : null,
      tagline: p.subtitle ?? null,
      overview: p.description ? { __type: 'prose', paragraphs: [p.description] } : null,
      methods: (p.methods ?? []).map((m) => ({ title: m.title, detail: m.description })),
    },
    ...(testimony
      ? {
          testimony: {
            __type: 'testimony',
            quote: testimony.testimony,
            author: testimony.name,
            role: testimony.job,
            company: testimony.company,
            image: avatar ?? null,
          },
        }
      : {}),
    next: next?.slug ? { __type: 'link', label: next.title, href: `/projects/${next.slug}` } : null,
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="project"
    title={p.title}
    subtitle={p.subtitle}
    back={{ href: '/projects', text: 'All projects' }}
    width="container-lg"
  >
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs" aria-label="Project facts">
      {p.role && <li class="glass px-3 py-1">{p.role}</li>}
      {years && <li class="glass px-3 py-1 tabular-nums">{years}</li>}
      {showCompany && <li class="glass px-3 py-1">{p.company?.name}</li>}
      {(p.stack ?? []).map((s) => <li class="glass px-3 py-1 text-muted">{s}</li>)}
    </ul>
    <Fragment slot="actions">
      {
        p.projectLink && (
          <Button href={p.projectLink} variant="primary" class="rounded-md" target="_blank">
            View_Live
          </Button>
        )
      }
      {
        p.sourceLink && (
          <Button href={p.sourceLink} variant="secondary" class="rounded-md" target="_blank" icon="tabler:brand-github">
            Source
          </Button>
        )
      }
    </Fragment>
  </PageHeader>

  {
    cover && (
      <div class="container-lg pb-12 lg:pb-16">
        <div class="glass glass-sheen rounded-xl p-1.5">
          <Image
            src={cover}
            alt={p.image?.alt ?? ''}
            class="w-full aspect-[16/9] object-cover rounded-lg bg-gray-400 dark:bg-slate-700"
            widths={[400, 960]}
            sizes="(max-width: 960px) 100vw, 960px"
            width={960}
            height={540}
            loading="eager"
          />
        </div>
      </div>
    )
  }

  {
    p.description && (
      <section class="container-lg pb-12 lg:pb-16">
        <p class="terminal-label">overview</p>
        <p class="mt-3 max-w-3xl text-base text-default leading-relaxed">{p.description}</p>
      </section>
    )
  }

  {
    methods.length > 0 && (
      <section class="container-lg pb-12 lg:pb-16">
        <p class="terminal-label">build</p>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">What went into it</h2>
        <ol class="mt-6 glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
          {methods.map((m, i) => (
            <li class="flex gap-4 px-4 sm:px-6 py-4">
              <span class="w-6 shrink-0 pt-0.5 text-xs font-bold text-primary tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="font-semibold text-default leading-snug">{m.title}</h3>
                {m.lead && <p class="mt-1 text-sm text-muted leading-relaxed">{m.lead}</p>}
                {m.rest && (
                  <details class="see-more mt-2">
                    <summary>
                      <span class="see-more-label">See</span>
                    </summary>
                    <p class="mt-2 text-sm text-muted leading-relaxed">{m.rest}</p>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    testimony && (
      <section class="container-lg pb-12 lg:pb-16">
        <p class="terminal-label">testimony</p>
        <figure class="mt-4 glass rounded-xl px-4 sm:px-6 py-5">
          <blockquote class="border-l-2 border-primary pl-4">
            <p class="text-base text-default leading-relaxed">{quoteLead}</p>
            {quoteRest && (
              <details class="see-more mt-2">
                <summary>
                  <span class="see-more-label">See</span>
                </summary>
                <p class="mt-2 text-sm text-muted leading-relaxed">{quoteRest}</p>
              </details>
            )}
          </blockquote>
          <figcaption class="mt-4 flex items-center gap-3">
            {avatar && (
              <Image
                src={avatar}
                alt=""
                width={40}
                height={40}
                class="w-10 h-10 shrink-0 rounded object-cover bg-gray-400 dark:bg-slate-700"
                loading="lazy"
              />
            )}
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-default">{testimony.name}</span>
              <span class="block text-xs uppercase tracking-widest text-muted">
                {[testimony.job, testimony.company].filter(Boolean).join(' · ')}
              </span>
            </span>
          </figcaption>
        </figure>
      </section>
    )
  }

  {
    next?.slug && next.slug !== p.slug && (
      <nav class="container-lg pb-16 lg:pb-24" aria-label="Next project">
        <a
          href={`/projects/${next.slug}`}
          class="glass rounded-xl group flex items-center justify-between gap-4 px-4 sm:px-6 py-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary"
          data-astro-prefetch
        >
          <span class="min-w-0">
            <span class="block text-xs uppercase tracking-widest text-muted">Next project</span>
            <span class="mt-1 block font-semibold text-default group-hover:text-primary transition-colors">
              {next.title}
            </span>
          </span>
          <Icon
            name="tabler:arrow-right"
            class="w-5 h-5 shrink-0 text-muted group-hover:text-primary transition-colors"
            aria-hidden="true"
          />
        </a>
      </nav>
    )
  }
</Layout>
