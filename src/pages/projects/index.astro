---
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import ProjectList from '~/components/widgets/ProjectList.astro';
import { projects } from '~/data/projects';
import { projectYears, stackCounts } from '~/utils/projects';

export const prerender = true;

const metadata = {
  title: 'Projects',
  description:
    'Products Jeremiah Chienda has built for governments, banks, telcos and his own startups, from IremboAI to GeniYanga.',
};

const founded = projects.filter((p) => /founder|creator/i.test(p.role ?? '')).length;
const ongoing = projects.filter((p) => /present/i.test(p.duration ?? '')).length;
const stack = stackCounts(projects);
// Show what recurs; the one-offs go behind "See more".
const stackCore = stack.filter((s) => s.count > 1);
const stackRest = stack.filter((s) => s.count === 1);

const dev = {
  front: [
    { key: 'count', value: String(projects.length), strong: true },
    { key: 'founded', value: String(founded) },
    { key: 'ongoing', value: String(ongoing) },
  ],
  chips: { key: 'stack', items: stack.slice(0, 8).map((s) => s.name) },
  data: {
    projects: projects.map((p) => ({
      title: p.title,
      subtitle: p.subtitle ?? null,
      company: p.company?.name ?? null,
      role: p.role ?? null,
      years: projectYears(p.duration),
      stack: p.stack ?? [],
      open: p.slug ? { __type: 'cta', label: 'Open', href: `/projects/${p.slug}` } : null,
      live: p.projectLink ? { __type: 'cta', label: 'Live', href: p.projectLink } : null,
    })),
    stack: Object.fromEntries(stack.map((s) => [s.name, s.count])),
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="projects"
    title="Things I've built"
    subtitle="For governments, banks, telcos and my own startups."
    width="container-lg"
  >
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs tabular-nums">
      <li class="glass px-3 py-1">{projects.length} projects</li>
      <li class="glass px-3 py-1">{founded} founded</li>
      <li class="glass px-3 py-1">{ongoing} ongoing</li>
    </ul>
  </PageHeader>

  <section class="container-lg pb-12 lg:pb-16" aria-label="All projects">
    <ProjectList projects={projects} />
  </section>

  <section class="container-lg pb-16 lg:pb-24">
    <p class="terminal-label">stack</p>
    <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">What they run on</h2>
    <p class="mt-2 text-sm text-muted">How many projects use each.</p>
    <ul class="mt-6 flex flex-wrap gap-2 text-xs">
      {
        stackCore.map((s) => (
          <li class="glass px-3 py-1">
            {s.name}{' '}
            <span class="text-muted tabular-nums">
              <span aria-hidden="true">×</span>
              {s.count}
              <span class="sr-only">projects</span>
            </span>
          </li>
        ))
      }
    </ul>
    {
      stackRest.length > 0 && (
        <details class="see-more mt-4">
          <summary>
            <span class="see-more-label">See</span>
          </summary>
          <p class="mt-3 text-sm text-muted">Used once: {stackRest.map((s) => s.name).join(', ')}.</p>
        </details>
      )
    }
  </section>
</Layout>
