---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Layout from '~/layouts/PageLayout.astro';
import { skills } from '~/data/skills';
import { findImage } from '~/utils/images';

export const prerender = true;

const metadata = {
  title: 'Agent Skills',
  description:
    'Open-source skills for coding agents by Jeremiah Chienda: a governance scorecard for AI agents, truescreen product videos built from your real UI, and evidence-explainer, which turns a voice note into a vertical explainer.',
};

const resolved = await Promise.all(
  skills.map(async (s) => ({ ...s, img: (await findImage(s.image.src)) as ImageMetadata }))
);

const dev = {
  front: [
    { key: 'status', value: `"${skills.length} open-source skills for coding agents"`, strong: true },
    { key: 'license', value: '"MIT"' },
  ],
  data: Object.fromEntries(
    resolved.map((s) => [
      s.slug === 'agent-governance-scorecard' ? 'scorecard' : s.slug,
      {
        skill: s.skillName,
        does: s.tagline,
        proof: s.proof,
        cover: s.img?.src ?? null,
        install: { __type: 'code', lang: 'bash', value: s.install },
        ask: s.ask,
        repo: { __type: 'cta', label: 'GitHub', href: s.repo },
      },
    ])
  ),
};
---

<Layout metadata={metadata} dev={dev}>
  <Hero2>
    <Fragment slot="title">Agent <span class="underlined">Skills</span></Fragment>

    <Fragment slot="subtitle">Open-source skills for coding agents. Install one, then ask.</Fragment>
  </Hero2>

  <section class="container pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12">
      {
        resolved.map((skill) => (
          <article id={skill.slug} class="flex flex-col">
            <a href={skill.repo} target="_blank" rel="noopener noreferrer" class="block">
              <Image
                src={skill.img}
                alt={skill.image.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded shadow-primary bg-gray-400 dark:bg-slate-700"
                width={960}
                loading="lazy"
              />
            </a>

            <h2 class="mt-8 text-3xl font-bold tracking-tighter font-heading text-heading">{skill.name}</h2>
            <p class="mt-3 text-lg text-default">{skill.tagline}</p>
            <p class="mt-2 text-muted">{skill.proof}</p>

            <div class="mt-auto pt-8">
              <div class="relative rounded border border-muted bg-black/5 dark:bg-white/5">
                <button
                  type="button"
                  class="absolute top-2 right-2 text-xs uppercase tracking-widest text-muted hover:text-primary"
                  data-skill-copy
                >
                  copy
                </button>
                <pre class="overflow-x-auto p-4 pt-8 md:pt-4 md:pr-16 text-sm font-mono"><code>{skill.install}</code></pre>
              </div>
              <p class="mt-3 text-sm text-muted">
                Then ask: <span class="text-default">"{skill.ask}"</span>
              </p>
              <a href={skill.repo} target="_blank" rel="noopener noreferrer" class="btn-tertiary inline-block mt-6">
                View on GitHub
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  const initSkillCopy = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-skill-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(code);
        btn.textContent = 'copied';
        setTimeout(() => (btn.textContent = 'copy'), 1500);
      };
    });
  };
  initSkillCopy();
  document.addEventListener('astro:page-load', initSkillCopy);
</script>
