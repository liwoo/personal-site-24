---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import Layout from '~/layouts/PageLayout.astro';
import { skills } from '~/data/skills';
import { findImage } from '~/utils/images';

export const prerender = true;

const metadata = {
  title: 'Agent Skills',
  description:
    'Open-source skills for coding agents by Jeremiah Chienda: a governance scorecard for AI agents, truescreen product videos built from your real UI, and evidence-explainer, which turns a voice note into a vertical explainer.',
};

const resolved = await Promise.all(
  skills.map(async (s) => ({ ...s, img: (await findImage(s.image.src)) as ImageMetadata }))
);

const dev = {
  front: [
    { key: 'status', value: `"${skills.length} open-source skills for coding agents"`, strong: true },
    { key: 'license', value: '"MIT"' },
  ],
  data: Object.fromEntries(
    resolved.map((s) => [
      s.slug === 'agent-governance-scorecard' ? 'scorecard' : s.slug,
      {
        skill: s.skillName,
        does: s.tagline,
        proof: s.proof,
        cover: s.img?.src ?? null,
        install: { __type: 'code', lang: 'bash', value: s.install },
        ask: s.ask,
        repo: { __type: 'cta', label: 'View_on_GitHub', href: s.repo },
      },
    ])
  ),
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="skills"
    title="Agent skills"
    subtitle="Open-source skills for coding agents. Install one, then ask."
    width="container-lg"
  >
    <ul slot="meta" class="flex flex-wrap gap-2 text-xs tabular-nums">
      <li class="glass px-3 py-1">{skills.length} skills</li>
      <li class="glass px-3 py-1">MIT</li>
    </ul>
  </PageHeader>

  <section class="container-lg pb-16 lg:pb-24" aria-label="All skills">
    <ul class="divide-y divide-gray-500/15 border-t border-gray-500/15">
      {
        resolved.map((skill) => (
          <li id={skill.slug} class="grid grid-cols-1 md:grid-cols-[16rem_minmax(0,1fr)] gap-5 md:gap-8 py-8">
            <div class="glass rounded-xl p-1.5 self-start">
              <Image
                src={skill.img}
                alt={skill.image.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded bg-gray-500/20"
                width={512}
                loading="lazy"
              />
            </div>

            <div class="min-w-0">
              <h2 class="text-xl font-bold tracking-tight text-heading">{skill.name}</h2>
              <p class="mt-1 text-sm text-muted leading-relaxed">{skill.tagline}</p>
              <details class="see-more mt-2">
                <summary>
                  <span class="see-more-label">See</span>
                </summary>
                <p class="mt-2 text-sm text-muted leading-relaxed">{skill.proof}</p>
              </details>

              <div class="skill-install glass rounded-xl mt-4 flex items-start gap-2">
                <pre class="flex-1 min-w-0 overflow-x-auto px-4 py-3 text-xs sm:text-sm"><code>{skill.install}</code></pre>
                <button
                  type="button"
                  class="shrink-0 px-3 py-3 text-xs uppercase tracking-widest text-muted hover:text-primary focus-visible:text-primary focus-visible:outline-none"
                  aria-label={`Copy install command for ${skill.name}`}
                  data-skill-copy
                >
                  copy
                </button>
                <span class="sr-only" aria-live="polite" data-skill-copy-status />
              </div>
              <p class="mt-3 text-sm text-muted">
                Then ask: <span class="text-default">"{skill.ask}"</span>
              </p>
              <div class="mt-4">
                <a href={skill.repo} target="_blank" rel="noopener noreferrer" class="btn-link text-xs">
                  View_on_GitHub
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  // ClientRouter fires astro:page-load on the first load too, so this is the
  // only call path. `dataset.bound` stops a double bind on revisits.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-skill-copy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const box = btn.closest('.skill-install');
      const status = box?.querySelector<HTMLElement>('[data-skill-copy-status]');
      btn.addEventListener('click', async () => {
        const code = box?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'copied';
          if (status) status.textContent = 'Install command copied';
        } catch {
          btn.textContent = 'select it';
          if (status) status.textContent = 'Copy failed. Select the command and copy it manually.';
        }
        setTimeout(() => {
          btn.textContent = 'copy';
          if (status) status.textContent = '';
        }, 1500);
      });
    });
  });
</script>
