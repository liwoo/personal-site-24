---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import Button from '~/components/ui/Button.astro';
import ContactWithRecaptcha from '~/components/widgets/ContactWithRecaptcha.tsx';
import { quickCall } from '~/data/booking';

const metadata = {
  title: 'Hire an AI Engineer',
  description:
    "Looking for an AI Engineer? I help companies build agent systems, RAG pipelines, and LLM-powered products. Let's talk.",
};

// What people reach out about. 1 line each; the form below routes the details.
const services = [
  { icon: 'tabler:briefcase', title: 'AI engineering', line: 'Agents, RAG and LLM products, from architecture to production.' },
  { icon: 'tabler:presentation', title: 'Speaking', line: 'Agent engineering and building AI for emerging markets.' },
  { icon: 'tabler:test-pipe', title: 'Research & training', line: 'Agent architectures, LLM integration, enterprise AI adoption.' },
  { icon: 'tabler:users', title: 'Mentorship', line: 'Free 30 min 1:1, usually pair programming.' },
];

const dev = {
  front: [
    { key: 'status', value: '"Open to AI engineering work: contract and full-time"', strong: true },
    { key: 'response_time', value: '"usually within 24h"' },
  ],
  data: {
    book: { __type: 'cta', label: 'Book_me', href: quickCall.href },
    contact: {
      __type: 'form',
      submit: 'Send_Message',
      submitHref: 'mailto:jeremiahchienda@gmail.com',
      fields: [
        { name: 'name', label: '"name"', placeholder: 'Your name', type: 'text' },
        { name: 'email', label: '"email"', placeholder: 'you@domain.com', type: 'email' },
        { name: 'message', label: '"message"', placeholder: 'What are you building?', type: 'textarea' },
      ],
    },
    services: services.map((s) => ({ title: s.title, detail: s.line })),
  },
};
---

<Layout metadata={metadata} dev={dev}>
  <PageHeader
    label="contact"
    title="Let's talk"
    subtitle="Contract or full-time: agents, RAG, LLM products. I reply within 24h."
  >
    <Fragment slot="actions">
      <Button href={quickCall.href} variant="primary" class="rounded-md" data-open-book-me aria-haspopup="dialog">
        Book_me
      </Button>
    </Fragment>
  </PageHeader>

  <div class="container pb-16 lg:pb-24 grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-12 items-start">
    <section class="lg:col-span-3" aria-label="Contact form">
      <ContactWithRecaptcha client:load />
    </section>

    <section class="lg:col-span-2" aria-labelledby="services-title">
      <p class="terminal-label">services</p>
      <h2 id="services-title" class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-heading">
        What I help with
      </h2>
      <ul class="mt-6 glass rounded-xl divide-y divide-gray-500/15 overflow-hidden">
        {
          services.map((s) => (
            <li class="flex gap-4 px-4 sm:px-6 py-4">
              <Icon name={s.icon} class="w-5 h-5 mt-0.5 shrink-0 text-primary" aria-hidden="true" />
              <div class="min-w-0">
                <h3 class="font-semibold text-default leading-snug">{s.title}</h3>
                <p class="mt-1 text-sm text-muted leading-snug">{s.line}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
